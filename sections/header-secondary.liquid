{{ 'header-secondary.css' | asset_url | stylesheet_tag }}

<header class="site-header">
  <div class="site-header__inner">
    <div class="site-header__bar">
      <div class="site-header__mobile-menu">
        <details class="mobile-menu">
          <summary
            class="site-header__icon site-header__icon--menu"
            aria-label="Open menu"
          >
            <span class="icon icon--hamburger">
              <svg width="22" height="22" viewBox="0 0 20 16" aria-hidden="true">
                <path
                  d="M1 1h18M1 8h18M1 15h18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                ></path>
              </svg>
            </span>
            <span class="icon icon--close">
              <svg width="22" height="22" viewBox="0 0 16 16" aria-hidden="true">
                <path
                  d="M2 2l12 12M14 2L2 14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                ></path>
              </svg>
            </span>
          </summary>
        </details>
      </div>

      <div class="site-header__search">
        <button
          type="button"
          class="site-header__icon site-header__icon--search"
          aria-label="Search"
          aria-expanded="false"
          aria-controls="HeaderSearchDrawer-{{ section.id }}"
          data-search-open
        >
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
            <circle
              cx="11"
              cy="11"
              r="7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
            ></circle>
            <path
              d="M16.5 16.5L21 21"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
            ></path>
          </svg>
        </button>
      </div>

      <div class="site-header__logo">
        <a
          href="{{ routes.root_url }}"
          class="site-header__logo-link"
          aria-label="{{ shop.name }}"
        >
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 300
              | image_tag:
                class: 'site-header__logo-image',
                loading: 'eager',
                widths: '90,135,180,240,300',
                alt: shop.name
            }}
          {% else %}
            <span class="site-header__logo-text">
              {{ shop.name }}
            </span>
          {% endif %}
        </a>
      </div>

      <div class="site-header__actions">
        {% if shop.customer_accounts_enabled %}
          <a
            href="{{ routes.account_url }}"
            class="site-header__action site-header__action--account"
            aria-label="Account"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              focusable="false"
              class="icon icon-account"
              fill="none"
              width="22"
              height="22"
              viewBox="0 0 18 19"
            >
                <path fill-rule="evenodd" clip-rule="evenodd" d="M6 4.5a3 3 0 116 0 3 3 0 01-6 0zm3-4a4 4 0 100 8 4 4 0 000-8zm5.58 12.15c1.12.82 1.83 2.24 1.91 4.85H1.51c.08-2.6.79-4.03 1.9-4.85C4.66 11.75 6.5 11.5 9 11.5s4.35.26 5.58 1.15zM9 10.5c-2.5 0-4.65.24-6.17 1.35C1.27 12.98.5 14.93.5 18v.5h17V18c0-3.07-.77-5.02-2.33-6.15-1.52-1.1-3.67-1.35-6.17-1.35z" fill="currentColor">
              </path>
            </svg>
          </a>
        {% endif %}

        <a
          href="{{ routes.cart_url }}"
          class="site-header__action site-header__action--cart"
          aria-label="Cart"
        >
          <svg
            class="header-icon__svg  header-cart__icon"
            viewBox="0 0 16 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect x="1" y="5.18433" width="14" height="13.1579" rx="2" stroke="currentColor" stroke-width="1"></rect>
            <path d="M10.3852 9.18735V4.04392C10.3852 2.72619 9.31698 1.65796 7.99925 1.65796C6.68151 1.65796 5.61328 2.72619 5.61328 4.04392V9.18735" stroke="currentColor" stroke-width="1"></path>
          </svg>

          {% if cart.item_count > 0 %}
            <span class="site-header__cart-count">
              {{ cart.item_count }}
            </span>
          {% endif %}
        </a>
      </div>
    </div>

    <nav class="site-header__navigation" aria-label="Main navigation">
      {% if section.settings.menu != blank %}
        <ul class="site-header__menu" role="list">
          {% for link in section.settings.menu.links %}
            <li class="site-header__menu-item">
              <a
                href="{{ link.url }}"
                class="site-header__menu-link"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>
  </div>

  <div class="mobile-menu__drawer" aria-label="Mobile menu">
    <nav class="mobile-menu__navigation" aria-label="Mobile navigation">
      {% if section.settings.menu != blank %}
        <ul class="mobile-menu__list" role="list">
          {% for link in section.settings.menu.links %}
            <li class="mobile-menu__item">
              <a href="{{ link.url }}" class="mobile-menu__link">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>
  </div>

  <div
    class="header-search__overlay"
    data-search-overlay
    hidden
  ></div>

  <div
    id="HeaderSearchDrawer-{{ section.id }}"
    class="header-search__drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Search"
    hidden
  >
    <form
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      class="header-search__form"
    >
      <div class="header-search__field">
        <input
          id="HeaderSearch-{{ section.id }}"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder=" "
          class="header-search__input"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        >

        <label
          class="header-search__label"
          for="HeaderSearch-{{ section.id }}"
        >
          Search
        </label>

        <button
          type="submit"
          class="header-search__submit"
          aria-label="Submit search"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
            <circle
              cx="11"
              cy="11"
              r="7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
            ></circle>
            <path
              d="M16.5 16.5L21 21"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
            ></path>
          </svg>
        </button>
      </div>

      <input
        type="hidden"
        name="options[prefix]"
        value="last"
      >

      <button
        type="button"
        class="header-search__close"
        aria-label="Close search"
        data-search-close
      >
        <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="M2 2l12 12M14 2L2 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </form>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var header = document.querySelector('.section-header-secondary .site-header');
    var menu = document.querySelector('.section-header-secondary .mobile-menu');
    var searchOpenBtn = document.querySelector('.section-header-secondary [data-search-open]');
    var searchCloseBtn = document.querySelector('.section-header-secondary [data-search-close]');
    var searchOverlay = document.querySelector('.section-header-secondary [data-search-overlay]');
    var searchDrawer = document.querySelector('.section-header-secondary .header-search__drawer');
    var searchInput = document.querySelector('.section-header-secondary .header-search__input');

    function isSearchOpen() {
      return header && header.classList.contains('is-search-open');
    }

    function syncBodyScroll() {
      var menuOpen = menu && menu.open;
      document.body.classList.toggle('no-scroll', Boolean(menuOpen || isSearchOpen()));
    }

    function openSearch() {
      if (!header || isSearchOpen()) return;

      if (menu && menu.open) {
        menu.open = false;
      }

      header.classList.add('is-search-open');

      if (searchOverlay) searchOverlay.hidden = false;
      if (searchDrawer) searchDrawer.hidden = false;
      if (searchOpenBtn) searchOpenBtn.setAttribute('aria-expanded', 'true');

      syncBodyScroll();

      window.requestAnimationFrame(function () {
        if (searchInput) searchInput.focus();
      });
    }

    function closeSearch() {
      if (!header || !isSearchOpen()) return;

      header.classList.remove('is-search-open');

      if (searchOverlay) searchOverlay.hidden = true;
      if (searchDrawer) searchDrawer.hidden = true;
      if (searchOpenBtn) searchOpenBtn.setAttribute('aria-expanded', 'false');

      syncBodyScroll();

      if (searchOpenBtn) searchOpenBtn.focus();
    }

    if (menu) {
      menu.addEventListener('toggle', syncBodyScroll);
    }

    if (searchOpenBtn) {
      searchOpenBtn.addEventListener('click', openSearch);
    }

    if (searchCloseBtn) {
      searchCloseBtn.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        closeSearch();
      });
    }

    if (searchOverlay) {
      searchOverlay.addEventListener('click', closeSearch);
    }

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && isSearchOpen()) {
        closeSearch();
      }
    });
  });
</script>

{% schema %}
{
  "name": "Header Secondary",
  "class": "section-header-secondary",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Header Secondary"
    }
  ]
}
{% endschema %}

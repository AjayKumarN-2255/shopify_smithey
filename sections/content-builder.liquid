{{ 'content-builder.css' | asset_url | stylesheet_tag }}
<section
  id="content-builder-{{ section.id }}"
  class="content-builder"
>
  <div class="content-builder__container">
    <div class="content-builder__left">
      {% for block in section.blocks %}
        {% if block.settings.position == 'left' %}
          {% case block.type %}
            {% when 'text' %}
              {% render 'content-builder-text', block: block %}

            {% when 'image' %}
              {% render 'content-builder-image', block: block %}

            {% when 'image_grid' %}
              {% render 'content-builder-image-grid', block: block %}

            {% when 'button' %}
              {% render 'content-builder-button', block: block %}

            {% when 'banner' %}
              {% render 'content-builder-banner', block: block %}

            {% when 'faq' %}
              {% render 'faq-item', block: block %}

            {% when 'login-form' %}
              {% render 'content-builder-login-form', block: block %}
          {% endcase %}
        {% endif %}
      {% endfor %}
    </div>

    <div class="content-builder__right">
      {% for block in section.blocks %}
        {% if block.settings.position == 'right' %}
          {% case block.type %}
            {% when 'text' %}
              {% render 'content-builder-text', block: block %}

            {% when 'image' %}
              {% render 'content-builder-image', block: block %}

            {% when 'image_grid' %}
              {% render 'content-builder-image-grid', block: block %}

            {% when 'button' %}
              {% render 'content-builder-button', block: block %}

            {% when 'banner' %}
              {% render 'content-builder-banner', block: block %}

            {% when 'faq' %}
              {% render 'faq-item', block: block %}

            {% when 'login-form' %}
              {% render 'content-builder-login-form', block: block %}
          {% endcase %}
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% if section.settings.show_features %}
    <div class="content-builder__features">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          {% render 'content-builder-feature', block: block %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>

<style>
  #content-builder-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }

  #content-builder-{{ section.id }} .content-builder__container,
  #content-builder-{{ section.id }} .content-builder__features {
    padding: {{ section.settings.mobile_padding }}rem;
  }

  @media (min-width: 920px) {
    #content-builder-{{ section.id }} .content-builder__container,
    #content-builder-{{ section.id }} .content-builder__features {
      padding: {{ section.settings.desktop_padding }}rem;
    }
    #content-builder-{{ section.id }} .content-builder__features {
      padding-top: {{ section.settings.desktop_padding | divided_by: 2 }}rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('content-builder-{{ section.id }}');
    if (!root) return;

    const faqItems = root.querySelectorAll('.faq__item');

    faqItems.forEach((item) => {
      const question = item.querySelector('.faq__question');
      if (!question) return;

      question.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        faqItems.forEach((faq) => faq.classList.remove('is-open'));

        if (!isOpen) {
          item.classList.add('is-open');
        }
      });
    });
  });
</script>


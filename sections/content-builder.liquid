{{ 'content-builder.css' | asset_url | stylesheet_tag }}
<section
  id="content-builder-{{ section.id }}"
  class="content-builder"
>
  <div class="content-builder__container">
    <div class="content-builder__left">
      {% for block in section.blocks %}
        {% if block.settings.position == 'left' %}
          {% case block.type %}
            {% when 'text' %}
              {% render 'content-builder-text', block: block %}

            {% when 'image' %}
              {% render 'content-builder-image', block: block %}

            {% when 'image_grid' %}
              {% render 'content-builder-image-grid', block: block %}

            {% when 'button' %}
              {% render 'content-builder-button', block: block %}
          {% endcase %}
        {% endif %}
      {% endfor %}
    </div>

    <div class="content-builder__right">
      {% for block in section.blocks %}
        {% if block.settings.position == 'right' %}
          {% case block.type %}
            {% when 'text' %}
              {% render 'content-builder-text', block: block %}

            {% when 'image' %}
              {% render 'content-builder-image', block: block %}

            {% when 'image_grid' %}
              {% render 'content-builder-image-grid', block: block %}

            {% when 'button' %}
              {% render 'content-builder-button', block: block %}
          {% endcase %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #content-builder-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }
  .content-builder {
    padding: {{ section.settings.mobile_padding}}rem;
  }

  @media (min-width: 920px) {
    .content-builder {
      padding: {{ section.settings.desktop_padding }}rem;
    }
  }
</style>


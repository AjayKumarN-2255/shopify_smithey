<section
  class="featured-article"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="featured-article__container">
    <!-- Image -->
    <div class="featured-article__media">
      <img
        src="{{ section.settings.article.image | image_url: width: 1200 }}"
        alt="{{ section.settings.article.image.alt | escape }}"
        loading="lazy"
      >
    </div>

    <!-- Content -->
    <div class="featured-article__content">
      <div>
        <div class="featured-article__category">
          {{ section.settings.article.metafields.custom.category }}
        </div>

        <h2 class="featured-article__title">
          {{ section.settings.article.title }}
        </h2>

        <div class="featured-article__excerpt">
          {{ section.settings.article.content | strip_html | truncate: 220 }}
        </div>
      </div>
      <div class="featured-article__footer">
        <a
          href="{{ section.settings.article.url }}"
          class="featured-article__link"
        >
          Read More
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .featured-article {
    margin: 2rem 0 0 0;
  }
  .featured-article__container {
    width: 100%;
    display: flex;
    flex-direction: column;
  }
  .featured-article__media {
    width: 100%;
    height: 25rem;
  }

  .featured-article__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-article__content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 28rem;
  }

  .featured-article__category {
    color: #b68b32;
    font-size: 9px;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    font-weight: bold;
    letter-spacing: 0.08rem;
  }

  .featured-article__title {
    color: #f3f3f3;
    font-family: Sentinel, ui-serif, serif;
    font-size: 28px;
    text-transform: none;
    margin-bottom: 1rem;
  }
  .featured-article__excerpt {
    color: #f3f3f3;
    font-family: Sentinel, ui-serif, serif;
    font-size: 16px;
    line-height: 1.5;
    font-style: italic;
    max-width: 482px;
  }

  .featured-article__excerpt p {
    margin-top: 1em;
    margin-bottom: 1em;
  }

  .featured-article__footer {
    width: 100%;
    padding: 0.75rem 0;
    border-top: 2px solid #b68b32;
  }

  .featured-article__link {
    color: #f3f3f3;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
  }

  @media (min-width: 920px) {
    .featured-article__container {
      flex-direction: row;
    }
    .featured-article__media {
      height: 34rem;
    }
    .featured-article__media,
    .featured-article__content {
      flex: 0 0 50%;
      max-width: 50%;
    }
    .featured-article__content {
      min-height: unset;
    }
    .featured-article__category {
      font-size: 13px;
    }
    .featured-article__title {
      font-size: 36px;
    }
    .featured-article__excerpt {
      font-size: 16px;
      line-height: 1.5;
      max-width: 550px;
    }
    .featured-article__content {
      padding: 3rem 3rem 1rem 3rem;
    }
    .featured-article__footer {
      width: 100%;
      padding: 1rem 0;
    }
    .featured-article__link {
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Story",
  "settings": [
    {
      "type": "article",
      "id": "article",
      "label": "Select article"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#495a57"
    }
  ],
  "presets": [
    {
      "name": "Featured Story"
    }
  ]
}
{% endschema %}

{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
<div class="cart-drawer-overlay" id="cart-drawer-overlay"></div>
<div class="cart-drawer" id="cart-drawer">
  <!-- Header -->
  <div class="cart-drawer__header">
    <h2 class="cart-drawer__title">YOUR CART ({{ cart.item_count }})</h2>

    <button
      type="button"
      class="cart-drawer__close"
      aria-label="Close cart"
    >
      <svg fill="none" height="32" viewBox="0 0 32 32" width="32" xmlns="http://www.w3.org/2000/svg">
        <circle cx="16" cy="16" fill="#f3f3f3" fill-opacity=".66" r="16"></circle><g stroke="#112626" stroke-linejoin="round" stroke-width="2"><path d="m22.1875 9.8125-12.375 12.375"></path><path d="m22.1875 22.1875-12.375-12.375"></path></g>
      </svg>
    </button>
  </div>

  {% if cart.item_count == 0 %}
    <!-- Empty Cart -->
    <div class="cart-drawer__empty">
      <p class="cart-drawer__empty-message">
        You have no items<br>
        in your cart.
      </p>

      <a
        href="{{ routes.all_products_collection_url }}"
        class="cart-drawer__shop-button"
      >
        START SHOPPING
      </a>
    </div>
    <div class="cart-drawer__recommendations-list">
      {% assign products = collections.all.products %}
      {% assign random_offset = 'now' | date: '%s' | modulo: products.size %}

      {% assign recommendation_count = 0 %}

      {% for product in products offset: random_offset %}
        {% assign already_in_cart = false %}

        {% for item in cart.items %}
          {% if item.product.id == product.id %}
            {% assign already_in_cart = true %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% unless already_in_cart %}
          <div class="cart-drawer__recommendation">
            <div class="cart-drawer__recommendation-info">
              <div class="cart-drawer__recommendation-image">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 150 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    width="75"
                    height="75"
                    loading="lazy"
                  >
                {% endif %}
              </div>

              <div class="cart-drawer__recommendation-details">
                <h4 class="cart-drawer__recommendation-title">
                  {{ product.title }}
                </h4>

                <span class="cart-drawer__recommendation-price">
                  {{ product.price | money }}
                </span>
              </div>
            </div>

            <form method="post" action="/cart/add">
              <input
                type="hidden"
                name="id"
                value="{{ product.selected_or_first_available_variant.id }}"
              >

              <button
                type="submit"
                class="cart-drawer__add-button"
              >
                ADD TO CART
              </button>
            </form>
          </div>

          {% assign recommendation_count = recommendation_count | plus: 1 %}

          {% if recommendation_count == 3 %}
            {% break %}
          {% endif %}
        {% endunless %}
      {% endfor %}
    </div>

  {% else %}
    <!-- Cart Items -->
    <div class="cart-drawer__items">
      {% for item in cart.items %}
        <div class="cart-drawer__item">
          <div class="cart-drawer__item-main">
            <div class="cart-drawer__item-image">
              {% if item.image %}
                <img
                  src="{{ item.image | image_url: width: 200 }}"
                  alt="{{ item.image.alt | escape }}"
                  width="100"
                  height="100"
                  loading="lazy"
                >
              {% endif %}
            </div>

            <div class="cart-drawer__item-details">
              <div class="cart-drawer__item-top">
                <h3 class="cart-drawer__item-title">
                  {{ item.product.title }}
                </h3>

                <span class="cart-drawer__item-price">
                  {{ item.final_line_price | money }}
                </span>
              </div>

              <div class="cart-drawer__item-actions">
                <div class="cart-drawer__quantity">
                  <button
                    type="button"
                    class="cart-drawer__quantity-button"
                  >
                    -
                  </button>

                  <span class="cart-drawer__quantity-value">
                    {{ item.quantity }}
                  </span>

                  <button
                    type="button"
                    class="cart-drawer__quantity-button"
                  >
                    +
                  </button>
                </div>

                <button
                  type="button"
                  class="cart-drawer__remove"
                >
                  REMOVE
                </button>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="cart-drawer__recommendations-list flex-1">
      {% assign products = collections.all.products %}
      {% assign random_offset = 'now' | date: '%s' | modulo: products.size %}

      {% assign recommendation_count = 0 %}

      {% for product in products offset: random_offset %}
        {% assign already_in_cart = false %}

        {% for item in cart.items %}
          {% if item.product.id == product.id %}
            {% assign already_in_cart = true %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% unless already_in_cart %}
          <div class="cart-drawer__recommendation ">
            <div class="cart-drawer__recommendation-info">
              <div class="cart-drawer__recommendation-image">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 150 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    width="75"
                    height="75"
                    loading="lazy"
                  >
                {% endif %}
              </div>

              <div class="cart-drawer__recommendation-details">
                <h4 class="cart-drawer__recommendation-title">
                  {{ product.title }}
                </h4>

                <span class="cart-drawer__recommendation-price">
                  {{ product.price | money }}
                </span>
              </div>
            </div>

            <form method="post" action="/cart/add">
              <input
                type="hidden"
                name="id"
                value="{{ product.selected_or_first_available_variant.id }}"
              >

              <button
                type="submit"
                class="cart-drawer__add-button"
              >
                ADD TO CART
              </button>
            </form>
          </div>

          {% assign recommendation_count = recommendation_count | plus: 1 %}

          {% if recommendation_count == 3 %}
            {% break %}
          {% endif %}
        {% endunless %}
      {% endfor %}
    </div>

    <!-- Gift Note -->
    <div class="cart-drawer__gift-note">
      <label class="cart-drawer__gift-note-label">
        <input
          type="checkbox"
          class="cart-drawer__gift-note-checkbox"
        >

        <span> ADD A GIFT NOTE TO YOUR ORDER </span>
      </label>
    </div>

    <!-- Footer -->
    <div class="cart-drawer__footer">
      <div class="cart-drawer__summary">
        <div class="cart-drawer__summary-row">
          <span class="cart-drawer__summary-label"> SUBTOTAL </span>

          <span class="cart-drawer__summary-value">
            {{ cart.total_price | money }}
          </span>
        </div>

        <div class="cart-drawer__summary-row">
          <span class="cart-drawer__summary-label"> SHIPPING </span>

          <span class="cart-drawer__shipping"> CALCULATED AT CHECKOUT </span>
        </div>
      </div>

      <a
        href="{{ routes.checkout_url }}"
        class="cart-drawer__checkout"
      >
        CHECKOUT
      </a>
    </div>
  {% endif %}
</div>

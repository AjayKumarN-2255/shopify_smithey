{{ 'media-tabs.css' | asset_url | stylesheet_tag }}
<section
  id="media-tabs-{{ section.id }}"
  class="media-tabs"
>
  <div class="media-tabs__container">
    <!-- Left -->
    <div class="media-tabs__left">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'text' %}
            <div
              class="media-tabs__text"
              {{ block.shopify_attributes }}
            >
              {% render 'content-builder-text', block: block %}
            </div>

          {% when 'video' %}
            <div
              class="media-tabs__video"
              {{ block.shopify_attributes }}
            >
              {% render 'content-builder-video', block: block %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <!-- Right -->
    <div class="media-tabs__right">
      <!-- Tab Navigation -->
      <div class="media-tabs__navigation">
        {% assign tab_index = 0 %}

        {% for block in section.blocks %}
          {% if block.type == 'tab_item' %}
            <button
              class="media-tabs__tab-button{% if tab_index == 0 %} is-active{% endif %}"
              type="button"
              data-tab="{{ tab_index }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.tab_name }}
            </button>

            {% assign tab_index = tab_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>

      <!-- Tab Panels -->
      <div class="media-tabs__panels">
        {% assign tab_index = 0 %}

        {% for block in section.blocks %}
          {% if block.type == 'tab_item' %}
            <div
              class="media-tabs__panel{% if tab_index == 0 %} is-active{% endif %}"
              data-panel="{{ tab_index }}"
            >
              {% if block.settings.title != blank %}
                <h3 class="media-tabs__panel-title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if block.settings.subtitle != blank %}
                <p class="media-tabs__panel-subtitle">
                  {{ block.settings.subtitle }}
                </p>
              {% endif %}

              {% if block.settings.content != blank %}
                <div class="media-tabs__panel-content">
                  {{ block.settings.content }}
                </div>
              {% endif %}
            </div>

            {% assign tab_index = tab_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  #media-tabs-{{ section.id }} {
    background: {{ section.settings.background_color }};
  }

  #media-tabs-{{ section.id }} .media-tabs__container {
    padding: {{ section.settings.container_padding_mobile }};
  }

  @media screen and (min-width: 920px) {
    #media-tabs-{{ section.id }} .media-tabs__container {
      padding: {{ section.settings.container_padding_desktop }};
    }
  }
  .media-tabs__panel {
  display: none;
  }

  .media-tabs__panel.is-active {
  display: block;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.media-tabs').forEach((section) => {
      const buttons = section.querySelectorAll('.media-tabs__tab-button');
      const panels = section.querySelectorAll('.media-tabs__panel');

      buttons.forEach((button, index) => {
        button.addEventListener('click', () => {
          buttons.forEach((btn) => btn.classList.remove('is-active'));
          panels.forEach((panel) => panel.classList.remove('is-active'));

          button.classList.add('is-active');
          panels[index].classList.add('is-active');
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Media Tabs",
  "tag": "section",
  "class": "media-tabs",
  "settings": [
    {
      "type": "text",
      "id": "container_padding_mobile",

          "label": "Shopify Video"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL",
          "default": "https://cdn.shopify.com/videos/c/o/v/45adf71f175249218edd70c67b3fc294.mp4"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster Image"
        },
        {
          "type": "number",
          "id": "mobile_height",
          "label": "Mobile Height (rem)",
          "default": 20
        },
        {
          "type": "number",
          "id": "desktop_height",
          "label": "Desktop Height (rem)",
          "default": 30
        },
        {
          "type": "number",
          "id": "large_desktop_height",
          "label": "Large Desktop Height (rem)",
          "default": 36
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Show Overlay",
          "default": true
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay Opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 35
        }
      ]
    },
    {
      "type": "tab_item",
      "name": "Tab Item",
      "settings": [
        {
          "type": "text",
          "id": "tab_name",
          "label": "Tab Name",
          "default": "Tab"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media Tabs"
    }
  ]
}

  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "number",
          "id": "title_desktop_size",
          "label": "Title Desktop Size (rem)",
          "default": 2
        },
        {
          "type": "number",
          "id": "title_mobile_size",
          "label": "Title Mobile Size (rem)",
          "default": 1
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#b68b32"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "number",
          "id": "content_desktop_size",
          "label": "Content Desktop Size (rem)",
          "default": 1
        },
        {
          "type": "number",
          "id": "content_mobile_size",
          "label": "Content Mobile Size (rem)",
          "default": 0.9
        },
        {
          "type": "color",
          "id": "content_color",
          "label": "Content Color",
          "default": "#112626"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            {
              "value": "left",

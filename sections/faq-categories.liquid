<section
  id="faq-categories-{{ section.id }}"
  class="faq-categories"
  style="background-color: {{ section.settings.background_color }};"
  data-faq-categories
>
  <div class="faq-categories__container">
    <div
      class="faq-categories__left"
      style="--left-width: {{ section.settings.left_width }}%;"
    >
      {% for category in section.blocks %}
        {% if category.type == 'category' %}
          <div
            id="faq-category-{{ category.settings.category_id }}"
            class="faq-categories__group"
            data-faq-group
          >
            <h2 class="faq-categories__heading">
              {{ category.settings.title }}
            </h2>

            <div class="faq-categories__items">
              {% for faq in section.blocks %}
                {% if faq.type == 'faq' and faq.settings.category_id == category.settings.category_id %}
                  {% render 'faq-item', block: faq %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <aside
      class="faq-categories__right"
      style="--right-width: {{ section.settings.right_width }}%;"
      data-faq-nav
    >
      <ul class="faq-categories__nav">
        {% assign faq_nav_index = 0 %}
        {% for category in section.blocks %}
          {% if category.type == 'category' %}
            <li>
              <a
                href="#faq-category-{{ category.settings.category_id }}"
                data-faq-nav-link
                {% if faq_nav_index == 0 %}class="is-active"{% endif %}
              >
                {{ category.settings.title }}
              </a>
            </li>
            {% assign faq_nav_index = faq_nav_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </ul>
    </aside>
  </div>
</section>

<style>
  #faq-categories-{{ section.id }} {
    padding: {{ section.settings.container_padding_mobile }};
  }

  #faq-categories-{{ section.id }} .faq-categories__container {
    display: flex;
    width: 100%;
    flex-direction: column-reverse;
    gap: 2rem;
  }

  #faq-categories-{{ section.id }} .faq-categories__group + .faq-categories__group {
    margin-top: 0;
  }

  #faq-categories-{{ section.id }} .faq-categories__group {
    scroll-margin-top: calc(var(--faq-sticky-offset, 0px) + 37px);
  }

  #faq-categories-{{ section.id }} .faq-categories__heading {
    margin: 24px 0;
    padding: 0;
    font-family: Gotham, ui-sans-serif, sans-serif !important;
    font-size: 17px !important;
    font-weight: 400 !important;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: none;
    color: #112626;
  }

  #faq-categories-{{ section.id }} .faq-categories__group:first-child .faq-categories__heading {
    margin-top: 0;
  }

  #faq-categories-{{ section.id }} .faq-categories__nav {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #faq-categories-{{ section.id }} .faq-categories__nav li {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border-top: none;
    border-bottom: 1px solid #d9d9d9;
  }

  #faq-categories-{{ section.id }} .faq-categories__nav li:last-child {
    border-bottom: 1px solid #d9d9d9;
  }

  #faq-categories-{{ section.id }} .faq-categories__nav a {
    display: block;
    padding: 0.5rem 0;
    text-decoration: none;
    font-family: Gotham, ui-sans-serif, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
    color: #112626;
  }

  #faq-categories-{{ section.id }} .faq-categories__nav a.is-active {
    font-weight: 700;
  }

  #faq-categories-{{ section.id }} .faq__item {
    width: 100%;
    max-width: 630px;
    margin: 0 0 24px;
    padding: 0 16px;
    border-top: 1px solid #000 !important;
    border-bottom: 1px solid #000 !important;
    box-sizing: border-box;
  }

  #faq-categories-{{ section.id }} .faq-categories__items .faq__item:last-child {
    margin-bottom: 0;
  }

  #faq-categories-{{ section.id }} .faq__question {
    height: 58px;
    min-height: 58px;
    padding: 0;
    align-items: center;
    box-sizing: border-box;
  }

  #faq-categories-{{ section.id }} .faq__question-text,
  #faq-categories-{{ section.id }} .faq__icon {
    font-family: Gotham, ui-sans-serif, sans-serif;
    font-weight: 500;
    font-size: 16px;
    letter-spacing: 0;
    line-height: 1.2;
    text-transform: none;
    color: #8f6a2a;
  }

  #faq-categories-{{ section.id }} .faq__answer {
    font-size: 16px;
    line-height: 1.45;
  }

  #faq-categories-{{ section.id }} .faq__item.is-open .faq__answer {
    max-height: 5000px;
    margin: 1rem 0;
  }

  @media (min-width: 920px) {
    #faq-categories-{{ section.id }} {
      padding: {{ section.settings.container_padding_desktop }};
    }

    #faq-categories-{{ section.id }} .faq-categories__container {
      flex-direction: row;
      max-width: 45rem;
      margin: 0 auto;
      gap: 2rem;
      align-items: flex-start;
    }

    #faq-categories-{{ section.id }} .faq-categories__left {
      width: var(--left-width);
      flex: 0 0 var(--left-width);
    }

    #faq-categories-{{ section.id }} .faq-categories__right {
      width: var(--right-width);
      flex: 0 0 var(--right-width);
      position: sticky;
      top: calc(var(--faq-sticky-offset, 0px) + 37px);
    }

    #faq-categories-{{ section.id }} .faq-categories__heading {
      font-size: 17px !important;
      font-weight: 400 !important;
    }

    #faq-categories-{{ section.id }} .faq-categories__nav a {
      font-size: 16px;
      padding: 0.6rem 0;
    }

    #faq-categories-{{ section.id }} .faq__question-text,
    #faq-categories-{{ section.id }} .faq__icon {
      font-size: 16px !important;
    }

    #faq-categories-{{ section.id }} .faq__answer {
      font-size: 15px !important;
      line-height: 1.5;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('faq-categories-{{ section.id }}');
    if (!root) return;

    var groups = root.querySelectorAll('[data-faq-group]');
    var links = root.querySelectorAll('[data-faq-nav-link]');
    var stickyAside = root.querySelector('[data-faq-nav]');
    if (!groups.length || !links.length) return;

    var HEADER_GAP = 37;

    function getHeader() {
      return document.querySelector('.site-header');
    }

    function getHeaderOffset() {
      var header = getHeader();
      if (!header) return 0;

      var styles = window.getComputedStyle(header);
      if (styles.position === 'fixed' || styles.position === 'sticky') {
        return header.offsetHeight;
      }

      return 0;
    }

    function updateStickyOffset() {
      if (!stickyAside) return;
      root.style.setProperty('--faq-sticky-offset', getHeaderOffset() + 'px');
    }

    function setActiveLink(id) {
      links.forEach(function (link) {
        var isActive = link.getAttribute('href') === '#' + id;
        link.classList.toggle('is-active', isActive);
      });
    }

    function updateActiveFromScroll() {
      var marker = getHeaderOffset() + HEADER_GAP + 1;
      var activeId = groups[0].id;

      groups.forEach(function (group) {
        if (group.getBoundingClientRect().top <= marker) {
          activeId = group.id;
        }
      });

      setActiveLink(activeId);
    }

    function onScrollOrResize() {
      updateStickyOffset();
      updateActiveFromScroll();
    }

    links.forEach(function (link) {
      link.addEventListener('click', function () {
        var id = link.getAttribute('href').slice(1);
        if (id) setActiveLink(id);
      });
    });

    window.addEventListener('scroll', onScrollOrResize, { passive: true });
    window.addEventListener('resize', onScrollOrResize);

    onScrollOrResize();
  })();
</script>

{% schema %}
{
  "name": "FAQ Categories",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "container_padding_desktop",
      "label": "Desktop Container Padding",
      "default": "2rem",
      "info": "Enter any valid CSS padding value. Examples: 2rem, 4rem 2rem, 4rem 2rem 3rem 1rem."
    },
    {
      "type": "text",
      "id": "container_padding_mobile",
      "label": "Mobile Container Padding",
      "default": "2rem",
      "info": "Enter any valid CSS padding value. Examples: 2rem, 2rem 1rem, 3rem 1.5rem 2rem 1rem."
    },
    {
      "type": "range",
      "id": "left_width",
      "label": "Left Column Width",
      "min": 50,
      "max": 80,
      "step": 5,
      "default": 70,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "right_width",
      "label": "Right Column Width",
      "min": 20,
      "max": 50,
      "step": 5,
      "default": 30,
      "unit": "%"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "category_id",
          "label": "Category ID",
          "info": "Example: cooking"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title"
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "category_id",
          "label": "Category ID",
          "info": "Must match a Category ID above."
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Categories"
    }
  ]
}
{% endschema %}

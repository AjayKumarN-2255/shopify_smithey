{{ 'quote-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quote-slider.js' | asset_url }}" defer></script>

<section
  class="quote-slider"
  style="--quote-slider-bg: {{ section.settings.background_color }}; --quote-slider-text: {{ section.settings.text_color }}; background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
>
  <div class="quote-slider__wrapper">
    {% if section.settings.heading != blank %}
      <h2
        class="quote-slider__heading"
        style="color: {{ section.settings.text_color }};"
      >
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="quote-slider__viewport">
        <div class="quote-slider__rail">
          {% for block in section.blocks %}
            <div
              class="quote-slider__slide"
              {{ block.shopify_attributes }}
            >
              <div class="quote-slider__slide-inner">
                {% if block.settings.subheading != blank %}
                  <p
                    class="quote-slider__subheading"
                    style="color: {{ section.settings.text_color }};"
                  >
                    {{ block.settings.subheading }}
                  </p>
                {% endif %}
              </div>

              <hr class="quote-slider__divider">

              <div class="quote-slider__slide-inner">
                <div class="quote-slider__quote-block">
                  {% if block.settings.quote != blank %}
                    <blockquote
                      class="quote-slider__quote"
                      style="color: {{ section.settings.text_color }};"
                    >
                      “{{ block.settings.quote | strip }}”
                    </blockquote>
                  {% endif %}

                  {% if block.settings.attribution != blank %}
                    <p
                      class="quote-slider__attribution"
                      style="color: {{ section.settings.text_color }};"
                    >
                      {{ block.settings.attribution }}
                    </p>
                  {% endif %}
                </div>
              </div>

              <hr class="quote-slider__divider">

              <div class="quote-slider__slide-inner">
                {% if block.settings.cta_label != blank %}
                  <a
                    href="{{ block.settings.cta_link | default: '#' }}"
                    class="quote-slider__cta"
                    style="color: {{ section.settings.text_color }};"
                  >
                    {{ block.settings.cta_label }}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 1 %}
        <div class="quote-slider__pagination" role="tablist" aria-label="Quote slides">
          {% for block in section.blocks %}
            <button
              type="button"
              class="quote-slider__dot{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Quote Slider",
  "tag": "section",
  "class": "section-quote-slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HOT OFF THE PRESS"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#be893d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#112626"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote card",
      "settings": [
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "THE 5 BEST CARBON STEEL PANS TO SEAR, FRY, AND BAKE IN, ACCORDING TO OUR TESTS"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Smithey’s hand-forged carbon steel skillets are stunning pieces of cookware that are just waiting to become family heirlooms."
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "Attribution",
          "default": "-FOOD AND WINE"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "SHOP OVAL ROASTER"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quote Slider",
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "subheading": "THE 5 BEST CARBON STEEL PANS TO SEAR, FRY, AND BAKE IN, ACCORDING TO OUR TESTS",
            "quote": "Smithey’s hand-forged carbon steel skillets are stunning pieces of cookware that are just waiting to become family heirlooms.",
            "attribution": "-FOOD AND WINE",
            "cta_label": "SHOP OVAL ROASTER"
          }
        },
        {
          "type": "quote",
          "settings": {
            "subheading": "THE 5 BEST CARBON STEEL PANS TO SEAR, FRY, AND BAKE IN, ACCORDING TO OUR TESTS",
            "quote": "Smithey’s hand-forged carbon steel skillets are stunning pieces of cookware that are just waiting to become family heirlooms.",
            "attribution": "-FOOD AND WINE",
            "cta_label": "SHOP OVAL ROASTER"
          }
        }
      ]
    }
  ]
}
{% endschema %}

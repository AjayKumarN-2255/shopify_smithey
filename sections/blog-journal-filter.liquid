{% unless blog.handle == 'recipies' %}
{%- liquid
  capture active_category
    render 'journal-active-category'
  endcapture
  assign active_category = active_category | strip

  assign source_blog = section.settings.blog
  if source_blog == blank and blog != blank
    assign source_blog = blog
  elsif source_blog == blank
    assign source_blog = blogs.journal
  endif

  assign journal_base = blog.url | default: source_blog.url | default: '/blogs/journal'
-%}

{% if active_category != blank %}
<section class="blog-featured blog-featured--filtered">
  {% if section.settings.title != blank %}
    <h2 class="blog-featured__heading">
      {{ section.settings.title }}
    </h2>
  {% endif %}

  {% render 'journal-category-nav', journal_base: journal_base, active_category: active_category %}

  <div class="blog-featured__container">
    {% if source_blog != blank %}
      {% for article in source_blog.articles %}
        {% assign article_category = article.metafields.custom.category | strip | downcase | replace: '-', ' ' %}
        {% assign matches_category = false %}

        {% if article_category == active_category %}
          {% assign matches_category = true %}
        {% else %}
          {% for tag in article.tags %}
            {% assign tag_down = tag | downcase | replace: '-', ' ' %}
            {% if tag_down == active_category %}
              {% assign matches_category = true %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% unless matches_category %}
          {% continue %}
        {% endunless %}

        {% render 'blog-featured-card', article: article %}
      {% endfor %}
    {% endif %}
  </div>
</section>

{% render 'blog-featured-styles' %}
{% endif %}
{% endunless %}

{% schema %}
{
  "name": "Journal filter listing",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "The Smithey Journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select blog"
    }
  ],
  "presets": [
    {
      "name": "Journal filter listing"
    }
  ]
}
{% endschema %}

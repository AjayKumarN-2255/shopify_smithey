{% unless blog.handle == 'recipies' %}
{%- liquid
  capture active_category
    render 'journal-active-category'
  endcapture
  assign active_category = active_category | strip

  assign source_blog = section.settings.blog
  if source_blog == blank and blog != blank
    assign source_blog = blog
  elsif source_blog == blank
    assign source_blog = blogs.journal
  endif

  assign journal_base = blog.url | default: source_blog.url | default: '/blogs/journal'

  assign view_param = active_category | replace: ' ', '-'
  assign per_page = 1

  capture page_param
    render 'get-url-param', key: 'page'
  endcapture
  assign current_page = page_param | strip
  if current_page == blank
    assign current_page = 1
  else
    assign current_page = current_page | plus: 0
  endif
  if current_page < 1
    assign current_page = 1
  endif

  assign offset = current_page | minus: 1 | times: per_page
-%}

{% if active_category != blank %}
<section class="blog-featured blog-featured--filtered">
  {% if section.settings.title != blank %}
    <h2 class="blog-featured__heading">
      {{ section.settings.title }}
    </h2>
  {% endif %}

  {% render 'journal-category-nav', journal_base: journal_base, active_category: active_category %}

  <div class="blog-featured__container">
    {% if source_blog != blank %}
      {% assign matched_count = 0 %}
      {% assign shown_count = 0 %}

      {% for article in source_blog.articles %}
        {% assign article_category = article.metafields.custom.category | strip | downcase | replace: '-', ' ' %}
        {% assign matches_category = false %}

        {% if article_category == active_category %}
          {% assign matches_category = true %}
        {% else %}
          {% for tag in article.tags %}
            {% assign tag_down = tag | downcase | replace: '-', ' ' %}
            {% if tag_down == active_category %}
              {% assign matches_category = true %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% unless matches_category %}
          {% continue %}
        {% endunless %}

        {% if matched_count >= offset and shown_count < per_page %}
          {% render 'blog-featured-card', article: article %}
          {% assign shown_count = shown_count | plus: 1 %}
        {% endif %}
        {% assign matched_count = matched_count | plus: 1 %}
      {% endfor %}
    {% endif %}
  </div>

  {% assign total_pages = matched_count | default: 0 | divided_by: per_page %}
  {% assign remainder = matched_count | default: 0 | modulo: per_page %}
  {% if remainder > 0 %}
    {% assign total_pages = total_pages | plus: 1 %}
  {% endif %}

  {% if total_pages > 1 %}
    <nav class="blog-featured__pagination" aria-label="Journal pagination">
      {% for page_num in (1..total_pages) %}
        <a
          href="{{ journal_base }}?view={{ view_param }}{% if page_num > 1 %}&page={{ page_num }}{% endif %}"
          class="blog-featured__pagination-link{% if page_num == current_page %} is-active{% endif %}"
          aria-label="Page {{ page_num }}"
          {% if page_num == current_page %}
            aria-current="page"
          {% endif %}
        >
          {{ page_num }}
        </a>
      {% endfor %}
    </nav>
  {% endif %}
</section>

{% render 'blog-featured-styles' %}
{% endif %}
{% endunless %}

{% schema %}
{
  "name": "Journal filter listing",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "The Smithey Journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select blog"
    }
  ],
  "presets": [
    {
      "name": "Journal filter listing"
    }
  ]
}
{% endschema %}

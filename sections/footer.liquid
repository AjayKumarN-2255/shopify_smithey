  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "desktop_width",
          "label": "Desktop Column Width",
          "default": "10rem",
          "info": "Enter a CSS width value such as 10rem, 15rem, or 20rem."

                          </svg>
                          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M12.4098 10.0498L12.8757 6.81625H9.95858V4.71822C9.95858 3.83434 10.3654 2.9709 11.6731 2.9709H13V0.218611C13 0.218611 11.7959 0 10.645 0C8.2426 0 6.6716 1.54758 6.6716 4.35177V6.81625H4V10.0498H6.6716V17.8647C7.2071 17.9544 7.75592 18 8.31509 18C8.87426 18 9.42308 17.9528 9.95858 17.8647V10.0498H12.4098Z" fill="white"></path>
                          </svg>
                          <svg width="22" height="16" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M19.2278 0.476133C20.159 0.737951 20.8854 1.5045 21.1372 2.48341C21.7958 5.27613 21.7529 10.5561 21.151 13.3925C20.902 14.3714 20.1728 15.135 19.2416 15.3998C16.6127 16.0834 4.83782 15.999 2.36109 15.3998C1.42989 15.138 0.703479 14.3714 0.451655 13.3925C-0.169603 10.7307 -0.12671 5.10159 0.437818 2.49795C0.686875 1.51904 1.41606 0.755406 2.34725 0.490678C5.86172 -0.280231 17.9769 -0.0315035 19.2278 0.476133ZM8.71094 4.53418L14.3562 7.93782L8.71094 11.3415V4.53418Z" fill="white"></path>
                          </svg>
                        </div>
                      </div>

                    {% when 'menu' %}
                      <div
                        class="footer__column footer__column--menu {{ visibility_class }}"
                        {% if show_desktop %}
                          {{ child.shopify_attributes }}
                        {% endif %}
                      >
                        {% if child.settings.heading != blank %}
                          <h3 class="footer__heading">
                            {{ child.settings.heading }}
                          </h3>
                        {% endif %}

                        {% if child.settings.menu != blank %}
                          <ul class="footer__menu-list">
                            {% for link in child.settings.menu.links %}
                              <li class="footer__menu-item">
                                <a
                                  href="{{ link.url }}"
                                  class="footer__menu-link"
                                >
                                  {{ link.title }}
                                </a>
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </div>

                    {% when 'text' %}
                      <div
                        class="footer__column footer__column--text {{ visibility_class }}"
                        {% if show_desktop %}
                          {{ child.shopify_attributes }}
                        {% endif %}
                      >
                        {% if child.settings.heading != blank %}
                          <h3 class="footer__heading">
                            {{ child.settings.heading }}
                          </h3>
                        {% endif %}

                        {% if child.settings.text != blank %}
                          <div class="footer__description">
                            {{ child.settings.text }}
                          </div>
                        {% endif %}
                      </div>
                  {% endcase %}
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</footer>

<style>
  #shopify-section-{{ section.id }},
  .footer {
    background-color: {{ section.settings.background_color }};
    background-image: url(https://smithey.com/cdn/shop/files/smithey-texture-dark.jpg?v=1676068986);
    background-repeat: repeat;
  }

  #shopify-section-{{ section.id }} .footer__container {
    padding: {{ section.settings.mobile_container_padding }};
  }

  #shopify-section-{{ section.id }} .footer__column--desktop-only {
    display: none;
  }

  @media (min-width: 1250px) {
    #shopify-section-{{ section.id }} .footer__container {
      padding: {{ section.settings.desktop_container_padding }};
    }

    #shopify-section-{{ section.id }} .footer__column-wrapper {
      width: var(--footer-block-width);
      flex: 0 0 var(--footer-block-width);
    }

    #shopify-section-{{ section.id }} .footer__column--desktop-only {
      display: block;
    }

    #shopify-section-{{ section.id }} .footer__column--mobile-only {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#0b2626"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "mobile_container_padding",
      "label": "Mobile Container Padding",
      "default": "0 1rem 0 1rem",
      "info": "Accepts any valid CSS padding value, e.g. 0 1rem 0 1rem"
    },
    {
      "type": "text",
      "id": "desktop_container_padding",
      "label": "Desktop Container Padding",
      "default": "0 1rem 0 1rem",
      "info": "Accepts any valid CSS padding value, e.g. 0 1rem 0 1rem"

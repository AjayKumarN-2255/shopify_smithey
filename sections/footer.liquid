{{ 'footer.css' | asset_url | stylesheet_tag }}

<footer class="footer">
  <div class="footer__container">
    {% if section.settings.logo != blank %}
      <div class="footer__branding">
        <h4 class="footer__title">US MADE COOKWARE</h4>

        <div class="footer__logo">
          {{ section.settings.logo | image_url: width: 300 | image_tag: loading: 'lazy' }}
        </div>

        <h4 class="footer__title">USE IT WELL</h4>
      </div>
    {% endif %}

    <div class="footer__flex">
      {% assign column_index = 0 %}

      {% for block in section.blocks %}
        {% if block.type == 'column' %}
          {% assign column_index = column_index | plus: 1 %}
          {% assign column_key = column_index | append: '' %}

          <div
            class="footer__column-wrapper"
            style="--footer-block-width: {{ block.settings.desktop_width }};"
            {{ block.shopify_attributes }}
          >
            {% for child in section.blocks %}
              {% if child.type == 'menu' or child.type == 'newsletter' or child.type == 'text' %}
                {% assign show_desktop = false %}
                {% assign show_mobile = false %}

                {% if child.settings.desktop_column == column_key %}
                  {% assign show_desktop = true %}
                {% endif %}

                {% if child.settings.mobile_column == column_key %}
                  {% assign show_mobile = true %}
                {% endif %}

                {% if show_desktop or show_mobile %}
                  {% if show_desktop and show_mobile %}
                    {% assign visibility_class = '' %}
                  {% elsif show_desktop %}
                    {% assign visibility_class = 'footer__column--desktop-only' %}
                  {% else %}
                    {% assign visibility_class = 'footer__column--mobile-only' %}
                  {% endif %}

                  {% case child.type %}
                    {% when 'newsletter' %}
                      <div
                        class="footer__column footer__column--newsletter {{ visibility_class }}"
                        {% if show_desktop %}
                          {{ child.shopify_attributes }}
                        {% endif %}
                      >
                        {% if child.settings.heading != blank %}
                          <h3 class="footer__heading">
                            {{ child.settings.heading }}
                          </h3>
                        {% endif %}

                        {% if child.settings.description != blank %}
                          <div class="footer__description">
                            {{ child.settings.description }}
                          </div>
                        {% endif %}

                        {% if child.settings.show_input %}
                          <form class="footer__newsletter-form">
                            <input
                              type="email"
                              name="contact[email]"
                              class="footer__newsletter-input"
                              placeholder="Email Address"
                              required
                            >

                            <button
                              type="submit"
                              class="footer__newsletter-button"
                            >
                              SIGN UP
                            </button>
                          </form>
                        {% endif %}
                      </div>

                    {% when 'menu' %}
                      <div
                        class="footer__column footer__column--menu {{ visibility_class }}"
                        {% if show_desktop %}
                          {{ child.shopify_attributes }}
                        {% endif %}
                      >
                        {% if child.settings.heading != blank %}
                          <h3 class="footer__heading">
                            {{ child.settings.heading }}
                          </h3>
                        {% endif %}

                        {% if child.settings.menu != blank %}
                          <ul class="footer__menu-list">
                            {% for link in child.settings.menu.links %}
                              <li class="footer__menu-item">
                                <a
                                  href="{{ link.url }}"
                                  class="footer__menu-link"
                                >
                                  {{ link.title }}
                                </a>
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </div>

                    {% when 'text' %}
                      <div
                        class="footer__column footer__column--text {{ visibility_class }}"
                        {% if show_desktop %}
                          {{ child.shopify_attributes }}
                        {% endif %}
                      >
                        {% if child.settings.heading != blank %}
                          <h3 class="footer__heading">
                            {{ child.settings.heading }}
                          </h3>
                        {% endif %}

                        {% if child.settings.text != blank %}
                          <div class="footer__description">
                            {{ child.settings.text }}
                          </div>
                        {% endif %}
                      </div>
                  {% endcase %}
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</footer>

<style>
  #shopify-section-{{ section.id }},
  .footer {
    background-color: {{ section.settings.background_color }};
    background-image: url(https://smithey.com/cdn/shop/files/smithey-texture-dark.jpg?v=1676068986);
    background-repeat: repeat;
  }

  #shopify-section-{{ section.id }} .footer__container {
    padding: {{ section.settings.mobile_container_padding }};
  }

  #shopify-section-{{ section.id }} .footer__column--desktop-only {
    display: none;
  }

  @media (min-width: 1250px) {
    #shopify-section-{{ section.id }} .footer__container {
      padding: {{ section.settings.desktop_container_padding }};
    }

    #shopify-section-{{ section.id }} .footer__column-wrapper {
      width: var(--footer-block-width);
      flex: 0 0 var(--footer-block-width);
    }

    #shopify-section-{{ section.id }} .footer__column--desktop-only {
      display: block;
    }

    #shopify-section-{{ section.id }} .footer__column--mobile-only {
      display: none;
    }
  }
</style>


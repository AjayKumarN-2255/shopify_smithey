{% unless blog.handle == 'recipies' %}
{%- liquid
  capture active_category
    render 'journal-active-category'
  endcapture
  assign active_category = active_category | strip

  assign source_blog = section.settings.blog
  if active_category == blank and blog != blank and source_blog != blank and blog.handle == source_blog.handle
    assign source_blog = blog
  elsif source_blog == blank and blog != blank
    assign source_blog = blog
  elsif source_blog == blank
    assign source_blog = blogs.journal
  endif

  assign article_limit = section.settings.limit
  assign article_offset = section.settings.offset
  if active_category != blank
    assign article_offset = 0
  endif

  assign journal_base = blog.url | default: source_blog.url | default: '/blogs/journal'
-%}
<section class="blog-featured">
  {% if section.settings.title != blank %}
    <h2 class="blog-featured__heading">
      {{ section.settings.title }}
    </h2>
  {% endif %}

  {% if blog.handle == 'journal' and section.settings.title != blank %}
    <nav class="blog-featured__tags" aria-label="Journal categories">
      <a
        href="{{ journal_base }}?category=care"
        {% if active_category == 'care' %}
          aria-current="page" class="is-active"
        {% endif %}
      >
        Care
      </a>
      <a
        href="{{ journal_base }}?category=craft"
        {% if active_category == 'craft' %}
          aria-current="page" class="is-active"
        {% endif %}
      >
        Craft
      </a>
      <a
        href="{{ journal_base }}?category=culinary"
        {% if active_category == 'culinary' %}
          aria-current="page" class="is-active"
        {% endif %}
      >
        Culinary
      </a>
      <a
        href="{{ journal_base }}?category=smithey-stories"
        {% if active_category == 'smithey stories' %}
          aria-current="page" class="is-active"
        {% endif %}
      >
        Smithey Stories
      </a>
    </nav>
  {% endif %}

  <div class="blog-featured__container">
    {% if source_blog != blank %}
      {% assign shown = 0 %}
      {% assign skipped = 0 %}
      {% for article in source_blog.articles %}
        {% assign article_category = article.metafields.custom.category | strip | downcase %}
        {% assign matches_category = false %}

        {% if active_category == blank %}
          {% assign matches_category = true %}
        {% elsif article_category == active_category %}
          {% assign matches_category = true %}
        {% else %}
          {% for tag in article.tags %}
            {% assign tag_down = tag | downcase %}
            {% if tag_down == active_category %}
              {% assign matches_category = true %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% unless matches_category %}
          {% continue %}
        {% endunless %}

        {% if skipped < article_offset %}
          {% assign skipped = skipped | plus: 1 %}
          {% continue %}
        {% endif %}

        {% if shown >= article_limit %}
          {% break %}
        {% endif %}
        {% assign shown = shown | plus: 1 %}

        <article class="blog-featured__card">
          {% if article.image %}
            <div class="blog-featured__image">
              <img
                src="{{ article.image | image_url: width: 800 }}"
                alt="{{ article.image.alt | escape }}"
                loading="lazy"
              >
            </div>
          {% endif %}

          <div class="blog-featured__content">
            {% if article.metafields.custom.category != blank %}
              <div class="blog-featured__category">
                {{ article.metafields.custom.category }}
              </div>
            {% endif %}

            <h2 class="blog-featured__title">
              {{ article.title }}
            </h2>

            <div class="blog-featured__excerpt">
              {{ article.excerpt | default: article.content | strip_html | truncate: 180 }}
            </div>
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

<style>
  .blog-featured__heading {
    color: #b68b32;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-align: center;
    text-transform: uppercase;
    font-weight: bold;
    margin: 3rem 0 40px;
  }

  .blog-featured__tags {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
    margin: 0 auto 3rem;
    padding: 0 1rem;
    max-width: 62rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .blog-featured__tags::-webkit-scrollbar {
    display: none;
  }

  .blog-featured__tags a {
    color: #112626;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .blog-featured__tags a.is-active {
    color: #b68b32;
  }

  .blog-featured__container {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    max-width: 62rem;
    margin: auto;
    padding: 0 1rem;
    gap: 3rem;
  }

  .blog-featured__category {
    font-size: 12px;
    font-weight: 300;
    text-transform: uppercase;
    margin: 0.75rem 0;
    color: #b68b32;
    letter-spacing: 2px;
  }

  .blog-featured__title {
    font-size: 28px;
    line-height: 1;
    font-weight: 300;
    color: #112626;
    margin-bottom: 1rem;
  }

  .blog-featured__excerpt {
    font-size: 12px;
    font-weight: 300;
    font-style: italic;
    margin: 2.98rem 0 2rem;
    line-height: 1.25rem;
  }

  .blog-featured__image {
    width: 100%;
    height: 18.14rem;
  }

  .blog-featured__image img {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 920px) {
    .blog-featured__heading {
      font-size: 36px;
      margin: 2.4rem 0 2.6rem;
    }
    .blog-featured__tags {
      gap: 1.6rem;
      margin-bottom: 2.4rem;
      padding: 0;
    }
    .blog-featured__excerpt {
      font-size: 16px;
      margin: 2.6rem 0 1rem;
      line-height: 1.25rem;
      max-width: 23rem;
    }
    .blog-featured__container {
      grid-template-columns: repeat(3, 1fr);
      padding: 0;
      gap: 2rem;
    }
    .blog-featured__image {
      height: 12.75rem;
    }
  }
</style>
{% endunless %}

{% schema %}
{
  "name": "Blog Featured",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "The Smithey Journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select blog"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of articles",
      "min": 1,
      "max": 12,
      "default": 3
    },
    {
      "type": "range",
      "id": "offset",
      "label": "Skip articles",
      "min": 0,
      "max": 12,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Blog Featured"
    }
  ]
}
{% endschema %}

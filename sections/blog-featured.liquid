{% unless blog.handle == 'recipies' %}
<section class="blog-featured">
  {% if section.settings.title != blank %}
    <h2 class="blog-featured__heading">
      {{ section.settings.title }}
    </h2>
  {% endif %}

  {% if blog.handle == 'journal' and section.settings.title != blank %}
    <nav class="blog-featured__tags" aria-label="Journal categories">
      <a href="/blogs/journal">Care</a>
      <a href="/blogs/journal">Craft</a>
      <a href="/blogs/journal">Culinary</a>
      <a href="/blogs/journal">Smithey Stories</a>
    </nav>
  {% endif %}

  <div class="blog-featured__container">
    {% if section.settings.blog != blank %}
      {% for article in section.settings.blog.articles limit: section.settings.limit offset: section.settings.offset %}
        <article class="blog-featured__card">
          {% if article.image %}
            <div class="blog-featured__image">
              <img
                src="{{ article.image | image_url: width: 800 }}"
                alt="{{ article.image.alt | escape }}"
                loading="lazy"
              >
            </div>
          {% endif %}

          <div class="blog-featured__content">
            {% if article.metafields.custom.category != blank %}
              <div class="blog-featured__category">
                {{ article.metafields.custom.category }}
              </div>
            {% endif %}

            <h2 class="blog-featured__title">
              {{ article.title }}
            </h2>

            <div class="blog-featured__excerpt">
              {{ article.excerpt | default: article.content | strip_html | truncate: 180 }}
            </div>
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

<style>
  .blog-featured__heading {
    color: #b68b32;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-align: center;
    text-transform: uppercase;
    font-weight: bold;
    margin: 3rem 0 40px;
  }

  .blog-featured__tags {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
    margin: 0 auto 3rem;
    padding: 0 1rem;
    max-width: 62rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .blog-featured__tags::-webkit-scrollbar {
    display: none;
  }

  .blog-featured__tags a {
    color: #112626;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .blog-featured__container {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    max-width: 62rem;
    margin: auto;
    padding: 0 1rem;
    gap: 3rem;
  }

  .blog-featured__category {
    font-size: 12px;
    font-weight: 300;
    text-transform: uppercase;
    margin: 0.75rem 0;
    color: #b68b32;
    letter-spacing: 2px;
  }

  .blog-featured__title {
    font-size: 28px;
    line-height: 1;
    font-weight: 300;
    color: #112626;
    margin-bottom: 1rem;
  }

  .blog-featured__excerpt {
    font-size: 12px;
    font-weight: 300;
    font-style: italic;
    margin: 2.98rem 0 2rem;
    line-height: 1.25rem;
  }

  .blog-featured__image {
    width: 100%;
    height: 18.14rem;
  }

  .blog-featured__image img {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 920px) {
    .blog-featured__heading {
      font-size: 36px;
      margin: 2.4rem 0 2.6rem;
    }
    .blog-featured__tags {
      gap: 1.6rem;
      margin-bottom: 2.4rem;
      padding: 0;
    }
    .blog-featured__excerpt {
      font-size: 16px;
      margin: 2.6rem 0 1rem;
      line-height: 1.25rem;
      max-width: 23rem;
    }
    .blog-featured__container {
      grid-template-columns: repeat(3, 1fr);
      padding: 0;
      gap: 2rem;
    }
    .blog-featured__image {
      height: 12.75rem;
    }
  }
</style>
{% endunless %}

{% schema %}
{
  "name": "Blog Featured",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "The Smithey Journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select blog"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of articles",
      "min": 1,
      "max": 12,
      "default": 3
    },
    {
      "type": "range",
      "id": "offset",
      "label": "Skip articles",
      "min": 0,
      "max": 12,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Blog Featured"
    }
  ]
}
{% endschema %}

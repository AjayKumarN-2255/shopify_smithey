{{ 'blog-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blog-grid.js' | asset_url }}" defer></script>
<section class="blog-grid">
  <div class="blog-grid__wrapper">
    <!-- Carousel -->
    <div class="blog-grid__carousel">
      <button
        type="button"
        class="blog-grid__button blog-grid__button--prev"
        aria-label="Previous"
      >
        <svg
          class="w-[30px] max-w-[30px] h-[26px] max-h-[26px]"
          width="26"
          height="30"
          viewBox="0 0 26 30"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path fill-rule="evenodd" clip-rule="evenodd" d="M26 14.9432L11.5969 20.5387L-0.000222087 30L2.34005 14.9986L0.000217438 -6.67176e-05L11.332 9.24475L26 14.9432Z" fill="#112626"></path>
        </svg>
      </button>
      <div class="blog-grid__track">
        {% for article in section.settings.blog.articles
          limit: section.settings.limit
          offset: section.settings.offset
        %}
          <div class="blog-grid__carousel-image">
            <img
              src="{{ article.image | image_url: width: 1200 }}"
              alt="{{ article.image.alt | escape }}"
              loading="lazy"
            >
            <div class="blog-grid__overlay">
              <div class="blog-grid-overlay__category">
                {{ article.metafields.custom.category }}
              </div>

              <div class="blog-grid__title">
                {{ article.title }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      <button
        type="button"
        class="blog-grid__button blog-grid__button--next"
        aria-label="Next"
      >
        <svg
          class="w-[30px] max-w-[30px] h-[26px] max-h-[26px]"
          width="26"
          height="30"
          viewBox="0 0 26 30"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path fill-rule="evenodd" clip-rule="evenodd" d="M26 14.9432L11.5969 20.5387L-0.000222087 30L2.34005 14.9986L0.000217438 -6.67176e-05L11.332 9.24475L26 14.9432Z" fill="#112626"></path>
        </svg>
      </button>
    </div>
    <!-- Side List -->
    <div class="blog-grid__list">
      {% for article in section.settings.blog.articles limit: section.settings.limit offset: section.settings.offset %}
        <article class="blog-grid__card">
          <div class="blog-grid__card-image">
            <img
              src="{{ article.image | image_url: width: 500 }}"
              alt="{{ article.image.alt | escape }}"
              loading="lazy"
            >
          </div>

          <div class="blog-grid__card-content">
            <div class="blog-grid__category">
              {{ article.metafields.custom.category }}
            </div>

            <div class="blog-grid-__excerpt">
              {{ article.title }}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog Grid",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Select blog"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of articles",
      "min": 1,
      "max": 12,
      "default": 3
    },
    {
      "type": "range",
      "id": "offset",
      "label": "Skip articles",
      "min": 0,
      "max": 12,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Blog Grid"
    }
  ]
}
{% endschema %}

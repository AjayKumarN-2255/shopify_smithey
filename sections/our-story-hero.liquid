<section
  class="our-story-hero"
  style="
    min-height: {{ section.settings.mobile_height }}vh;
    {% if section.settings.image %}
      background-image: url('{{ section.settings.image | image_url: width: 2000 }}');
    {% endif %}
  "
>
  <div class="our-story-hero__content">
    {% if section.settings.title != blank %}
      <h1 class="our-story-hero__title">
        {{ section.settings.title }}
      </h1>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <p class="our-story-hero__subtitle">
        {{ section.settings.subtitle }}
      </p>
    {% endif %}

    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'input' %}
          <div class="contact-input" {{ block.shopify_attributes }}>
            <input
              type="text"
              class="contact-input__field"
              placeholder="{{ block.settings.placeholder }}"
            >
          </div>
      {% endcase %}
    {% endfor %}

    <div class="contact-card-container">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'contact_card' %}
            <div class="contact-card" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <div class="contact-card__icon">
                  <img
                    src="{{ block.settings.icon | image_url }}"
                    alt="{{ block.settings.title }}"
                    width="40"
                    height="40"
                  >
                </div>
              {% endif %}

              <div class="contact-card__content">
                {% if block.settings.title != blank %}
                  <h3 class="contact-card__title">
                    {{ block.settings.title }}
                  </h3>
                {% endif %}

                {% if block.settings.text != blank %}
                  <p class="contact-card__text">
                    {{ block.settings.text }}
                  </p>
                {% endif %}
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
    {% for block in section.blocks %}
      {% if block.type == 'contact_tab' %}
        {% render 'contact-tab' %}
      {% endif %}
    {% endfor %}
  </div>
</section>

<style>
  .our-story-hero {
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .our-story-hero__title {
    font-size: 18px;
    text-transform: uppercase;
    font-weight: bold;
    text-align: center;
    color: white;
  }

  .our-story-hero__content{
    wid
    border:5px solid #b68b32;
    padding: 10px 30px;
  }

  .contact-input input{
    width: 100%;
    padding: 0.75rem;
    margin: 2rem 0;
    border-radius: 10px;
    font-size: 14px;
    padding: 1rem;
    border: none;
    outline: none;
  }

  .contact-card-container{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:2rem;
  }

  .contact-card{
    display:flex;
    gap:1rem;
    color:white;
  }

  .contact-card__icon img {
    display: inline-block;
    max-width: 28px;
    height: 28px;
  }

  .contact-card__content{
    display:flex;
    flex-direction:column;
    gap:0.25rem;
  }

  .contact-card__title,
  .contact-card__text{
    font-size:14px;
  }

  @media (min-width: 920px) {
    .our-story-hero {
      min-height: {{ section.settings.desktop_height }}vh !important;
    }

    .our-story-hero__title {
      font-size: 36px;
    }

    .contact-card-container {
      flex-direction:row;
      justify-content:center;
    }

    .contact-card{
      gap:0.75rem;
    }

    .contact-card__icon img {
      max-width: 34px;
      height:34px;
    }

    .contact-card__title,
    .contact-card__text{
      font-size:16px;
    }
  }
</style>
{% schema %}
{
  "name": "Our Story Hero",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Background Image"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop Section Height",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 70,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile Section Height",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 60,
      "unit": "vh"
    }
  ],
  "blocks": [
    {
      "type": "input",
      "name": "Input",
      "settings": [
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder",
          "default": "WHAT CAN WE HELP YOU WITH?"
        }
      ]
    },
    {
      "type": "contact_card",
      "name": "Contact Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "contact_tab",
      "name": "Contact tab"
    }
  ],
  "presets": [
    {
      "name": "Our Story Hero"
    }
  ]
}
{% endschema %}

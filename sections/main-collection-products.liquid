{{ 'main-collection-products.css' | asset_url | stylesheet_tag }}

<section
  id="main-collection-products-{{ section.id }}"
  class="main-collection-products"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="main-collection-container">
    {% comment %}
      On a collection page with products, keep that collection so a picker
      set to "All" cannot replace it. If the page collection is empty, use
      the collection selected in the section settings.
    {% endcomment %}
    {% if request.page_type == 'collection' and collection != blank and collection.products_count > 0 %}
    {% elsif section.settings.collection != blank and section.settings.collection.handle != 'all' %}
      {% assign collection = section.settings.collection %}
    {% endif %}

    {% if section.settings.show_inline_nav %}
      <ul class="inline-nav">
        <li>
          <a href="/products/glass-lids">GLASS LIDS</a>
        </li>

        <li>
          <a
            href="/collections/accessories"
            {% if collection.handle == 'accessories' %}
              class="active"
              aria-current="page"
            {% endif %}
          >
            Accessories
          </a>
        </li>

        <li>
          <a
            href="/collections/best-sellers"
            {% if collection.handle == 'best-sellers' %}
              class="active"
              aria-current="page"
            {% endif %}
          >
            Best Sellers
          </a>
        </li>

        <li>
          <a href="/products/giftcard">Gift Cards</a>
        </li>
      </ul>
    {% endif %}

    {% if collection != blank %}
      {% if section.settings.show_collection_title %}
        <div class="main-collection-products__header">
          <h2 class="main-collection-products__title">
            {% if section.settings.custom_title != blank %}
              {{ section.settings.custom_title }}
            {% else %}
              {{ collection.title }}
            {% endif %}
          </h2>
        </div>
      {% endif %}
    {% endif %}
    {% if collection != blank %}
      <div class="main-collection-products__grid">
        {% for product in collection.products limit: section.settings.products_to_show %}
          <article
            class="
              product-card
              {% if forloop.index == section.settings.featured_product_index_desktop %}
                product-card--featured-desktop
              {% endif %}
              {% if forloop.index == section.settings.featured_product_index_mobile %}
                product-card--featured-mobile
              {% endif %}
            "
            style="
              {% if forloop.index == section.settings.featured_product_index_desktop %}
                --featured-column-span-desktop: {{ section.settings.featured_column_span }};
              {% endif %}
              {% if forloop.index == section.settings.featured_product_index_mobile %}
                --featured-column-span-mobile: {{ section.settings.featured_column_span }};
              {% endif %}
            "
          >
            <a href="{{ product.url }}" class="product-card__link">
              {% assign secondary_image = nil %}
              {% if product.images.size > 1 %}
                {% for image in product.images %}
                  {% unless image == product.featured_image %}
                    {% assign secondary_image = image %}
                    {% break %}
                  {% endunless %}
                {% endfor %}
              {% endif %}

              <div class="product-card__image-wrapper{% if secondary_image != blank %} product-card__image-wrapper--has-secondary{% endif %}">
                {% if product.featured_image != blank %}
                  {% assign primary_alt = product.featured_image.alt | default: product.title %}
                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      class: 'product-card__image product-card__image--primary',
                      alt: primary_alt
                  }}
                {% endif %}

                {% if secondary_image != blank %}
                  {% assign secondary_alt = secondary_image.alt | default: product.title %}
                  {{
                    secondary_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      class: 'product-card__image product-card__image--secondary',
                      alt: secondary_alt
                  }}
                {% endif %}
              </div>
            </a>

            {% assign is_first_product = forloop.first %}
            {% for block in section.blocks %}
              {% if block.type == 'card_text' and block.settings.text != blank %}
                <div
                  class="product-card__note product-card__note--{{ block.id }}"
                  {% if is_first_product %}
                    {{ block.shopify_attributes }}
                  {% endif %}
                >
                  {{ block.settings.text }}
                </div>
              {% endif %}
            {% endfor %}

            <a href="{{ product.url }}" class="product-card__link">
              <div class="product-card__content">
                <h3 class="product-card__title">
                  {{ product.title }}
                </h3>

                <div class="product-card__footer">
                  <p class="product-card__material">
                    {{ product.metafields.custom.material }}
                  </p>
                  <span class="product-card__price_mobile">
                    {{ product.price | money }}
                  </span>
                </div>

                <div class="product-card__footer">
                  <div class="product-card__reviews">
                    {% assign rating = product.metafields.custom.rating.value | default: 0 %}

                    <span class="product-card__rating">
                      {% for i in (1..5) %}
                        {% if i <= rating %}
                          ★
                        {% else %}
                          ☆
                        {% endif %}
                      {% endfor %}
                    </span>

                    <span class="product-card__review-count">
                      {{ product.metafields.custom.reviews_count }}
                      Reviews
                    </span>
                  </div>

                  <span class="product-card__price">
                    {{ product.price | money }}
                  </span>
                </div>
              </div>
            </a>

            {% for block in section.blocks %}
              {% if block.type == 'add_to_cart' %}
                {% assign cart_variant = product.selected_or_first_available_variant %}
                <form
                  class="product-card__add product-card__add--{{ block.id }}"
                  method="post"
                  action="/cart/add"
                  {% if is_first_product %}
                    {{ block.shopify_attributes }}
                  {% endif %}
                >
                  <input type="hidden" name="id" value="{{ cart_variant.id }}">
                  <button
                    type="submit"
                    class="product-card__add-button"
                    {% unless product.available %}
                      disabled
                    {% endunless %}
                  >
                    {% if product.available %}
                      {{ block.settings.button_text }}
                    {% else %}
                      Sold out
                    {% endif %}
                  </button>
                </form>
              {% endif %}
            {% endfor %}
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
    #main-collection-products-{{ section.id }} .main-collection-products__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
    }

    #main-collection-products-{{ section.id }} .product-card.product-card--featured-mobile {
      grid-column: span var(--featured-column-span-mobile);
    }

    @media (min-width: 920px) {
      #main-collection-products-{{ section.id }} .main-collection-products__grid {
        grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
      }
      #main-collection-products-{{ section.id }} .product-card.product-card--featured-mobile {
        grid-column: unset;
      }

      #main-collection-products-{{ section.id }} .product-card.product-card--featured-desktop {
        grid-column: span var(--featured-column-span-desktop);
      }
    }
</style>

{% for block in section.blocks %}
  {% if block.type == 'card_text' %}
    {% assign note_selector = '#main-collection-products-' | append: section.id | append: ' .product-card__note--' | append: block.id %}
    <style>
      {{ note_selector }} {
        color: {{ block.settings.text_color }};
        font-size: {{ block.settings.text_mobile_size }}rem;
      }

      @media (min-width: 920px) {
        {{ note_selector }} {
          font-size: {{ block.settings.text_desktop_size }}rem;
        }
      }

      {{ block.settings.custom_css | replace: '&', note_selector }}
    </style>
  {% elsif block.type == 'add_to_cart' %}
    {% assign add_selector = '#main-collection-products-' | append: section.id | append: ' .product-card__add--' | append: block.id %}
    <style>
      {{ add_selector }} .product-card__add-button {
        background-color: {{ block.settings.button_bg_color }};
        color: {{ block.settings.button_text_color }};
      }

      {{ block.settings.custom_css | replace: '&', add_selector }}
    </style>
  {% endif %}
{% endfor %}

{% if section.settings.custom_css != blank %}
  {% assign section_css_selector = '#main-collection-products-' | append: section.id %}
  <style>
    {{ section.settings.custom_css | replace: '#SECTION_ID', section_css_selector }}
  </style>
{% endif %}

{% schema %}
{
  "name": "Main Collection Products",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_inline_nav",
      "label": "Show top navigation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "Show collection title",
      "default": true
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom Title"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "default": "4",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "featured_product_index_desktop",
      "label": "Featured product position (Desktop)",
      "info": "1 = first product, 2 = second product, etc.",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "featured_product_index_mobile",
      "label": "Featured product position (Mobile)",
      "info": "1 = first product, 2 = second product, etc.",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "featured_column_span",
      "label": "Featured product column span",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Use #SECTION_ID to target this section. Example: #SECTION_ID .product-card { background: #fff; }"
    }
  ],
  "blocks": [
    {
      "type": "card_text",
      "name": "Card Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Common text",
          "info": "Shown below the product image on every card in this section."
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#112626"
        },
        {
          "type": "number",
          "id": "text_desktop_size",
          "label": "Desktop size (rem)",
          "default": 0.9
        },
        {
          "type": "number",
          "id": "text_mobile_size",
          "label": "Mobile size (rem)",
          "default": 0.8
        },
        {
          "type": "textarea",
          "id": "custom_css",
          "label": "Custom CSS",
          "info": "Use '&' to target this text on every card. Example: '& { text-align: center; margin-top: 0.5rem; }'"
        }
      ]
    },
    {
      "type": "add_to_cart",
      "name": "Add to Cart",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Add to Cart"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Button background",
          "default": "#b68b32"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text color",
          "default": "#112626"
        },
        {
          "type": "textarea",
          "id": "custom_css",
          "label": "Custom CSS",
          "info": "Use '&' to target this button on every card. Example: '& { margin-top: 0.5rem; }'"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main Collection Products"
    }
  ]
}
{% endschema %}

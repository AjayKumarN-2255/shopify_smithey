<section class="footer-bottom">
  <div class="footer-bottom__container">
    {% if section.settings.logo != blank %}
      <div class="footer-bottom__logo">
        {{ section.settings.logo | image_url: width: 2200 | image_tag: loading: 'lazy' }}
      </div>
    {% endif %}

    <div class="footer-bottom__content">
      {% if section.settings.copyright != blank %}
        <p class="footer-bottom__copyright">
          {{ section.settings.copyright }}
        </p>
      {% endif %}

      {% if section.settings.menu != blank %}
        <ul class="footer-bottom__menu">
          {% for link in section.settings.menu.links %}
            <li>
              <a href="{{ link.url }}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    <a
      class="footer-bottom__privacy-choices"
      href="{{ section.settings.privacy_choices_link | default: '/opt-out' }}"
    >
      <img
        class="footer-bottom__privacy-choices-icon"
        src="https://polaris.truevaultcdn.com/static/assets/icons/optout-icon-black.svg"
        alt=""
        width="30"
        height="14"
        loading="lazy"
      >
      <span class="footer-bottom__privacy-choices-text">
        {{ section.settings.privacy_choices_label | default: 'YOUR PRIVACY CHOICES' }}
      </span>
    </a>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }},
  .section-footer-bottom,
  .footer-bottom {
    background-color: {{ section.settings.background_color }};
    background-image: url(https://smithey.com/cdn/shop/files/smithey-texture-dark.jpg?v=1676068986);
    background-repeat: repeat;
  }

  .footer-bottom {
    width: 100%;
    padding: 50px 7px;
  }

  .footer-bottom__logo {
    width: 100%;
    max-width: none;
    margin-bottom: 38px;
  }

  .footer-bottom__logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .footer-bottom__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0;
    margin-bottom: 1.5rem;
  }

  .footer-bottom__copyright {
    font-size: 12px;
    color: #f3f3f3;
    margin-bottom: 13px;
    letter-spacing: 0.1em;
  }

  .footer-bottom__menu {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    max-width: 20rem;
    margin-bottom: 0;
  }

  .footer-bottom__menu a {
    color: #f3f3f3;
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 450;
    font-size: 10px;
    line-height: 12px;
  }

  .footer-bottom__privacy-choices {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #f3f3f3;
    margin-bottom: 0;
  }

  .footer-bottom__privacy-choices-icon {
    display: block;
    width: 30px;
    height: auto;
    filter: invert(1);
  }

  .footer-bottom__privacy-choices-text {
    font-size: 10px;
    line-height: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 450;
  }

  @media (min-width: 920px) {
    .footer-bottom {
      padding: 2.5rem 1.1rem;
    }

    .footer-bottom__logo {
      width: 100%;
      margin-bottom: 1.9rem;
    }

    .footer-bottom__content {
      flex-direction: row;
      justify-content: space-between;
      align-items: start;
      margin-bottom: 1.65rem;
    }

    .footer-bottom__menu {
      max-width: none;
      margin-bottom: 0;
    }

    .footer-bottom__privacy-choices {
      margin-bottom: 0.8rem;
    }
  }
</style>

{% schema %}
{
  "name": "Footer Bottom",
  "tag": "section",
  "class": "section-footer-bottom",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#032626"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Large Logo"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright Text",
      "default": "COPYRIGHT SMITHEY IRONWARE 2026."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Bottom Menu"
    },
    {
      "type": "text",
      "id": "privacy_choices_label",
      "label": "Privacy Choices Label",
      "default": "YOUR PRIVACY CHOICES"
    },
    {
      "type": "url",
      "id": "privacy_choices_link",
      "label": "Privacy Choices Link"
    }
  ],
  "presets": [
    {
      "name": "Footer Bottom"
    }
  ]
}
{% endschema %}

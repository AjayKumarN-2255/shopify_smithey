<section
  class="video-banner"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="video-banner__wrapper">
    {% if section.settings.video_url != blank %}
      <div class="video-banner__media">
        <video
          class="video-banner__video"
          muted
          loop
          playsinline
          preload="none"
          {% if section.settings.poster != blank %}
            poster="{{ section.settings.poster | image_url: width: 1920 }}"
          {% endif %}
        >
          <source
            src="{{ section.settings.video_url }}"
            type="video/mp4"
          >
          Your browser does not support the video tag.
        </video>

        {% if section.settings.poster != blank %}
          <img
            class="video-banner__poster"
            src="{{ section.settings.poster | image_url: width: 1920 }}"
            alt="{{ section.settings.heading | escape }}"
            width="{{ section.settings.poster.width }}"
            height="{{ section.settings.poster.height }}"
            loading="lazy"
          >
        {% endif %}

        <div class="video-banner__overlay">
          <div class="video-banner__content">
            {% if section.settings.heading != blank %}
              <h2 class="video-banner__heading">
                {{ section.settings.heading }}
              </h2>
            {% endif %}

            <button
              type="button"
              class="video-banner__play"
              aria-label="Play video"
            >
              <svg viewBox="0 0 34 34" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <g fill-rule="evenodd">
                  <path d="M17 0c9.389 0 17 7.611 17 17s-7.611 17-17 17S0 26.389 0 17 7.611 0 17 0zm0 1C8.163 1 1 8.163 1 17s7.163 16 16 16 16-7.163 16-16S25.837 1 17 1z" fill-rule="nonzero"></path>
                  <path d="M13.31 24.933a.679.679 0 01-.323-.083.675.675 0 01-.346-.587V10.87c0-.243.134-.468.346-.586a.676.676 0 01.68.019l10.715 6.697a.672.672 0 010 1.135l-10.715 6.697a.673.673 0 01-.356.102"></path>
                </g>
              </svg>
            </button>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const media = document.querySelector('.video-banner__media');

    if (!media) return;

    const video = media.querySelector('.video-banner__video');
    const poster = media.querySelector('.video-banner__poster');
    const overlay = media.querySelector('.video-banner__overlay');
    const playButton = media.querySelector('.video-banner__play');

    const hideOverlay = () => {
      if (poster) poster.classList.add('is-hidden');
      if (overlay) overlay.classList.add('is-hidden');
    };

    const showOverlay = () => {
      if (video.paused && video.currentTime === 0) {
        if (poster) poster.classList.remove('is-hidden');
        if (overlay) overlay.classList.remove('is-hidden');
      }
    };

    const togglePlayback = () => {
      if (video.paused) {
        hideOverlay();
        video.play();
      } else {
        video.pause();
      }
    };

    video.addEventListener('click', togglePlayback);

    if (playButton) {
      playButton.addEventListener('click', (event) => {
        event.stopPropagation();
        togglePlayback();
      });
    }

    video.addEventListener('play', hideOverlay);
    video.addEventListener('pause', showOverlay);
    video.addEventListener('ended', showOverlay);
  });
</script>

<style>
  .video-banner {
    width: 100%;
    padding: 1.5rem 1rem;
    margin: 3.5rem 0;
  }

  .video-banner__wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .video-banner__media {
    position: relative;
    width: 100%;
  }

  .video-banner__video {
    width: 100%;
    height: 14rem;
    display: block;
    object-fit: cover;
    cursor: pointer;
  }

  .video-banner__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .video-banner__poster.is-hidden {
    opacity: 0;
    visibility: hidden;
  }

  .video-banner__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    z-index: 2;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .video-banner__overlay.is-hidden {
    opacity: 0;
    visibility: hidden;
  }

  .video-banner__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    pointer-events: auto;
  }

  .video-banner__heading {
    color: #fff;
    text-align: center;
    text-transform: uppercase;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .video-banner__play {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: #fff;
    line-height: 0;
  }

  .video-banner__play svg {
    width: 2.25rem;
    height: 2.25rem;
    fill: currentColor;
  }

  @media (min-width: 920px) {
    .video-banner {
      padding: 3rem 1rem ;
      margin: 2.25rem 0;
    }

    .video-banner__wrapper {
      width: 100%;
      max-width: 95%;
      margin: 0 auto;
    }

    .video-banner__video {
      width: 100%;
      height: 42.5rem;
      object-fit: cover;
    }

    .video-banner__content {
      gap: 0;
    }

    .video-banner__heading {
      font-size: 2rem;
      letter-spacing: 0.04em;
    }

    .video-banner__play {
      margin-top: 0.5rem;
    }

    .video-banner__play svg {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Video Banner",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#112626"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "default": "https://cdn.shopify.com/videos/c/o/v/dfb7550f7ace4c94986db2bff645ff21.mp4"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Thumbnail / Poster Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE SMITHEY STORY"
    }
  ],
  "presets": [
    {
      "name": "Video Banner"
    }
  ]
}
{% endschema %}

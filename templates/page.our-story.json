            "title": "The Smithey Story",
            "title_desktop_size": 1.5,
            "title_mobile_size": 2.1,
            "title_color": "#b68b32",
            "content": "<p>Smithey Ironware is a backyard story. Our founder, Isaac Morton, hatched the idea for Smithey while toying around his woodshed admiring the smooth surfaces and timeless logos of vintage ironware design.  Here, he developed an expertise in restoring old and forgotten pieces into surprisingly stunning cookware, which he would then gift to friends and family.</p>",
            "content_desktop_size": 0.8,
            "content_mobile_size": 1,
            "content_color": "#112626",
            "position": "left"
          }
        },
        "image_grid_dxDUxt": {
          "type": "image_grid",
          "settings": {
            "image_1": "shopify://shop_images/01222021-SmitheyMiniSkillet-LIFESTYLE2523_1000x1000_8c727d55-5896-400b-8058-965fac965f04.webp",
            "image_2": "shopify://shop_images/Homescreen_option_1000x1000_551134cc-92ac-4b6f-83f8-a9d7f5fafbc1.webp",

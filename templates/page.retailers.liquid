{% assign retailers = retailers_json | parse_json %}

<div
  class="retailers-page"
  data-retailers-page
>
  <section
    class="retailers-locator"
    data-retailers-locator
  >
    <!--
      ==========================================
           Header
      ===========================================
    -->

    <header class="retailers-header">
      <h1 class="retailers-title">Find A Smithey Near You</h1>

      <p class="retailers-description">Search by city, ZIP code, or address to find a Smithey retailer near you.</p>
    </header>

    <!--
      ==========================================
           Search
      ===========================================
    -->

    <form
      id="retailers-search-form"
      class="retailers-search"
      data-retailers-search
      role="search"
    >
      <div class="retailers-search-field">
        <label
          for="retailers-search-input"
          class="retailers-search-label"
        >
          Location
        </label>

        <input
          id="retailers-search-input"
          class="retailers-search-input"
          data-retailers-search-input
          type="search"
          name="q"
          placeholder="Enter city, ZIP, or address"
          autocomplete="off"
        >
      </div>

      <button
        id="retailers-search-button"
        class="retailers-search-button"
        data-retailers-search-button
        type="submit"
      >
        <span>Search</span>
      </button>

      <button
        id="retailers-location-button"
        class="retailers-location-button"
        data-retailers-location-button
        type="button"
      >
        <span>Use my location</span>
      </button>
    </form>

    <p
      class="retailers-location-message"
      data-retailers-location-message
      hidden
      role="status"
    ></p>

    <!--
      ==========================================
           Main Content
      ===========================================
    -->

    <div
      class="retailers-content"
      data-retailers-content
    >
      <!--
        ========================================
             Retailer Results
        =========================================
      -->

      <div
        id="retailers-results"
        class="retailers-results"
        data-retailers-results
      >
        <div
          class="retailers-results-header"
          data-retailers-results-header
        >
          <p
            id="retailers-results-count"
            class="retailers-results-count"
            data-retailers-count
          >
            {% if retailers.first.id %}
              {% if retailers.size == 1 %}
                1 retailer found
              {% elsif retailers.size == 2 %}
                2 retailers found
              {% else %}
                3 retailers found
              {% endif %}
            {% endif %}
          </p>
        </div>

        <!-- Retailer List -->

        <ul
          id="retailers-results-list"
          class="retailers-list"
          data-retailers-list
        >
          {% if retailers.first.id %}
          {% for retailer in retailers limit: 3 %}
            <li class="retailers-list-item">
              <article
                class="retailer-card"
                data-retailer-card
                data-retailer-id="{{ retailer.id }}"
                data-lat="{{ retailer.lat }}"
                data-lng="{{ retailer.lng }}"
                {% if forloop.first %}
                  data-selected="true"
                {% endif %}
              >
                <h2
                  class="retailer-card__name"
                  data-retailer-name
                >
                  {{ retailer.name }}
                </h2>

                <address
                  class="retailer-card__address"
                  data-retailer-address
                >
                  {{ retailer.address }}

                  {% if retailer.city != blank or retailer.state != blank or retailer.postal_code != blank %}
                    <br>

                    {% if retailer.city != blank %}
                      {{ retailer.city }}
                    {% endif %}

                    {% if retailer.city != blank and retailer.state != blank %}
                      ,
                    {% endif %}

                    {% if retailer.state != blank %}
                      {{ retailer.state }}
                    {% endif %}

                    {% if retailer.postal_code != blank %}
                      {{ retailer.postal_code }}
                    {% endif %}
                  {% endif %}

                  {% if retailer.country != blank %}
                    <br>

                    {{ retailer.country }}
                  {% endif %}
                </address>

                <!-- Distance -->

                <p
                  class="retailer-card__distance"
                  data-retailer-distance
                  hidden
                ></p>

                <!-- Phone -->

                {% if retailer.phone != blank %}
                  <p
                    class="retailer-card__phone"
                    data-retailer-phone
                  >
                    <a
                      href="tel:{{ retailer.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}"
                    >
                      {{ retailer.phone }}
                    </a>
                  </p>
                {% endif %}

                <!-- Website -->

                {% if retailer.website != blank %}
                  <p
                    class="retailer-card__website"
                    data-retailer-website
                  >
                    <a
                      href="{{ retailer.website }}"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Visit website
                    </a>
                  </p>
                {% endif %}

                <!-- Hours -->

                {% if retailer.hours != blank %}
                  <p
                    class="retailer-card__hours"
                    data-retailer-hours
                  >
                    {{ retailer.hours }}
                  </p>
                {% endif %}
              </article>
            </li>
          {% endfor %}
          {% endif %}
        </ul>

        <!--
          ========================================
               Empty State
          =========================================
        -->

        <div
          id="retailers-empty"
          class="retailers-empty"
          data-retailers-empty
          hidden
        >
          <p>No retailers found near you.</p>
        </div>
      </div>

      <!--
        ========================================
             Map
        =========================================
      -->

      <div
        class="retailers-map"
        data-retailers-map-wrapper
      >
        <div
          id="retailers-map"
          class="retailers-map-container"
          data-retailers-map
          role="region"
          aria-label="Retailer map"
        ></div>
      </div>
    </div>
  </section>
</div>

<!--
  ==========================================
       Retailer Data
  ===========================================
-->

<script
  type="application/json"
  id="retailers-data"
  data-retailers-data
>
{{ retailers_json | strip }}
</script>

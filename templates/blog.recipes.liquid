<section class="blog-recipes">
  <div class="blog-recipes__container">
    <h1 class="blog-recipes__title">
      {% if article %}
        {{ article.title }}
      {% endif %}
    </h1>

    {% if article and article.image %}
      <div class="blog-recipes__image">
        <img
          src="{{ article.image | image_url: width: 1200 }}"
          alt="{{ article.image.alt | default: article.title | escape }}"
          loading="lazy"
        >
      </div>
    {% endif %}

    {% if article %}
      <div class="blog-recipes__details">
        <div class="blog-recipes__ingredients">
          <h2 class="blog-recipes__details-title">Ingredients</h2>
          <h2 class="blog-recipes__details-serve">Serves {{ article.metafields.custom.servings }}</h2>
          <div class="blog-recipes__ingr-container">
            {{ article.metafields.custom.ingredients | metafield_tag }}
            <a
              class="recipe-print-button"
              href="https://cdn.shopify.com/s/files/1/0269/8225/2637/files/spring_veggie_fritatta_recipe.pdf?v=1713887617"
              target="_blank"
            >
              PRINT THIS RECIPE
            </a>
          </div>
        </div>

        <div class="blog-recipes__description">
          <h2 class="blog-recipes__details-title">Instructions</h2>
          <div class="blog-recipes__instructions">
            {{ article.content }}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .blog-recipes {
    width: 100%;
  }

  .blog-recipes__container {
    width: 100%;
    max-width: 56rem;
    margin: 0 auto;
    padding: 1.28rem 1.06rem;
  }

  .blog-recipes__title {
    color: #112626;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.1;
    margin: 0 auto 1rem auto;
    text-align: center;
    max-width: 22rem;
    text-transform: uppercase;
    word-spacing: 2px;
    letter-spacing: 1px;
  }

  .blog-recipes__image {
    width: 100%;
    overflow: hidden;
  }

  .blog-recipes__image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .blog-recipes__details {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin-top: 1.5rem;
  }

  .blog-recipes__ingredients,
  .blog-recipes__description {
    width: 100%;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.5;
    color: #112626;
  }

  .blog-recipes__details-title {
    color: #112626;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 0.5rem;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 1px;
  }

  .blog-recipes__details-serve {
    font-size: 16px;
    font-weight: 300;
    display: none;
  }

  .blog-recipes__ingredients p {
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 0.35rem;
    color: #b68b32;
    max-width: 20rem;
  }

  .blog-recipes__ingr-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .recipe-print-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    margin: 2.5rem auto 1.5rem;
    padding: 1.25rem 1.5rem;
    background-color: #183d3e;
    color: #ffffff;
    font-family: inherit;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    border: none;
    border-radius: 0;
  }

  .blog-recipes__instructions {
    counter-reset: recipe-step;
    margin-top: 0.5rem;
  }

  .blog-recipes__instructions ol,
  .blog-recipes__instructions ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blog-recipes__instructions ol li,
  .blog-recipes__instructions ul li,
  .blog-recipes__instructions > p {
    position: relative;
    margin: 0 0 1rem 3rem;
    padding: 1rem 1.25rem;
    border: 1px solid #b68b32;
    background: #ffffff;
    color: #112626;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
    counter-increment: recipe-step;
  }

  .blog-recipes__instructions ol li::before,
  .blog-recipes__instructions ul li::before,
  .blog-recipes__instructions > p::before {
    content: counter(recipe-step);
    position: absolute;
    left: -3rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid #b68b32;
    border-radius: 50%;
    background: #ffffff;
    color: #b68b32;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1;
  }

  .blog-recipes__instructions ol li:last-child,
  .blog-recipes__instructions ul li:last-child,
  .blog-recipes__instructions > p:last-child {
    margin-bottom: 0;
  }

  .blog-recipes__instructions ol li p,
  .blog-recipes__instructions ul li p {
    margin: 0;
  }

  @media (min-width: 920px) {
    .blog-recipes__container {
      padding: 2.5rem 0 1rem 0;
      border-bottom: 1px solid #e5e5e5;
    }

    .blog-recipes__title {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 2px;
      margin-bottom: 1.5rem;
      max-width: unset;
    }

    .blog-recipes__image img {
      height: 100%;
    }

    .blog-recipes__details {
      grid-template-columns: repeat(2, 1fr);
      margin-top: 2rem;
    }

    .blog-recipes__ingredients,
    .blog-recipes__description {
      font-size: 16px;
    }

    .blog-recipes__description h2 {
      text-align: center;
      margin-bottom: 1rem;
    }

    .blog-recipes__details-title {
      font-size: 20px;
      text-align: start;
      margin-bottom: 0.25rem;
    }

    .blog-recipes__details-serve {
      display: block;
      margin-bottom: 0.5rem;
    }

    .blog-recipes__ingr-container {
      padding: 0 0.25rem;
      align-items: flex-start;
    }

    .recipe-print-button {
      margin: 2rem 0 0;
      padding: 1rem 1.5rem;
    }

    .blog-recipes__instructions ol li,
    .blog-recipes__instructions ul li,
    .blog-recipes__instructions > p {
      padding: 1.15rem 1.5rem;
      font-size: 17px;
    }
  }
</style>

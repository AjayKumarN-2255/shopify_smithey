{% section 'founder-message' %}

<section class="founder-note-banner" aria-label="Founder note tagline">
  <p class="founder-note-banner__text founder-note-banner__text--desktop">
    COOKWARE FOR HOME CHEFS WHO LOVE TO COOK AND APPRECIATE FINE<br>
    CRAFTSMANSHIP
  </p>
  <p class="founder-note-banner__text founder-note-banner__text--mobile">
    COOKWARE FOR HOME<br>
    CHEFS WHO LOVE TO<br>
    COOK AND APPRECIATE<br>
    FINE CRAFTSMANSHIP
  </p>
</section>

<style>
  .founder-note-banner {
    background-color: #0b2626;
    width: 100%;
    padding: 3.5rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .founder-note-banner__text {
    margin: 0;
    color: #ffffff;
    text-align: center;
    text-transform: uppercase;
    font-family: Gotham, ui-sans-serif, sans-serif;
    font-weight: 700;
    letter-spacing: 3px;
  }

  .founder-note-banner__text--desktop {
    display: none;
    font-size: 14px;
    line-height: 1.55;
  }

  .founder-note-banner__text--mobile {
    display: block;
    font-size: 16px;
    line-height: 1.45;
    max-width: 18rem;
  }

  @media (min-width: 920px) {
    .founder-note-banner {
      padding: 4.5rem 2rem;
    }

    .founder-note-banner__text--mobile {
      display: none;
    }

    .founder-note-banner__text--desktop {
      display: block;
      max-width: none;
    }
  }

  .founder-message__description {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .founder-message__read-more,
  .founder-message__signature {
    display: none;
  }

  .founder-message__container {
    padding: 0;
    margin: 0;
  }

  .founder-message__content {
    padding: 15px;
  }

  .founder-message__title {
    font-size: 13px;
    color: #b68b32;
    margin-bottom: 18px;
    letter-spacing: 3px;
  }

  .founder-message__description,
  .founder-message__description p {
    font-size: 18px;
    line-height: 1.4;
    font-weight: 500;
    color: #112626;
  }

  .founder-message__description h4 {
    display: block;
  }

  .founder-message__description .w-\[312px\] {
    display: flex;
    flex-direction: column;
    text-align: center;
    align-items: center;
    justify-content: center;
    margin-top: 30px;
    margin-left: auto;
    margin-right: auto;
  }

  .founder-message__description .w-\[312px\] h5,
  .founder-message__description .w-\[312px\] h4 {
    font-size: 14px;
  }

  .founder-message__description .w-\[312px\] h5 {
    color: #b68b32;
  }

  .founder-message__description .w-\[312px\] h4 {
    color: #112626;
    font-weight: 500 !important;
    letter-spacing: 1px;
    margin-top: 5px;
  }

  .founder-message__description .w-\[312px\] h4 strong {
    font-weight: 500 !important;
  }

  @media (max-width: 919px) {
    .founder-message__description .w-\[312px\] h4 {
      max-width: 20rem;
      letter-spacing: 2px;
      margin-bottom: 7px;
    }
  }

  @media (min-width: 920px) {
    .founder-message {
      padding: 3rem 0;
    }

    .founder-message__container {
      width: 100%;
      max-width: 56rem;
      height: 42rem;
      margin-left: auto;
      margin-right: auto;
      flex-direction: row-reverse;
    }

    .founder-message__image,
    .founder-message__content {
      flex: 0 0 50%;
      height: 100%;
    }

    .founder-message__content {
      padding: 30px;
    }

    .founder-message__image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>

{% comment %}
  Reads the blog tag from a /tagged/ URL segment via request.path
  (supported Liquid; does not use content_for_header).
  Usage: {% render 'get-url-tag' %}
{% endcomment %}

{%- liquid
  assign tag_value = blank

  if request.path contains '/tagged/'
    assign tag_value = request.path | split: '/tagged/' | last | split: '/' | first | url_decode | replace: '-', ' '
  endif

  echo tag_value
-%}

<div class="mobile-menu__nav">
  {% if left_menu != blank %}
    <ul class="mobile-menu_left__link">
      {% for link in left_menu.links %}
        <li class="mobile-menu__item">
          {% if link.handle == 'shop' or link.handle == 'cook' %}
            <a
              href="{{ link.url }}"
              class="mobile-menu__link"
              data-mobile-panel-trigger="{{ link.handle }}"
              aria-expanded="false"
              aria-controls="mobile-menu-panel-{{ link.handle }}"
            >
              <span class="mobile-menu__title">{{ link.title }}</span>
              <svg
                width="15"
                height="16"
                viewBox="0 0 15 16"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="flex-shrink-0"
                aria-hidden="true"
              >
                <path d="M6.58789 10.9531L0 16L1.33008 8L6.99381e-07 0L6.43945 4.93164L14.7666 7.96973L6.58789 10.9531Z" fill="#B68B32"></path>
              </svg>
            </a>
          {% else %}
            <span href="{{ link.url }}" class="mobile-menu__link">
              <span class="mobile-menu__title">{{ link.title }}</span>
              <svg
                width="15"
                height="16"
                viewBox="0 0 15 16"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="flex-shrink-0"
                aria-hidden="true"
              >
                <path d="M6.58789 10.9531L0 16L1.33008 8L6.99381e-07 0L6.43945 4.93164L14.7666 7.96973L6.58789 10.9531Z" fill="#B68B32"></path>
              </svg>
            </span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if right_menu != blank %}
    <ul class="mobile-menu_right__list">
      {% for link in right_menu.links %}
        {% assign menu_handle = link.handle | append: '-menu' %}

        <li class="mobile-menu__item">
          <span href="{{ link.url }}" class="mobile-menu_right__link">
            <span class="mobile-menu__title">{{ link.title }}</span>

            <svg
              width="22"
              height="22"
              viewBox="0 0 22 22"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="flex-shrink-0 transition-transform duration-300"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="11" fill="white" fill-opacity="0.33"></circle>
              <path d="M5.5 11H16.5" stroke="#112626" stroke-linejoin="round"></path>
              <path d="M11 5.5V16.5" stroke="#112626" stroke-linejoin="round"></path>
            </svg>
          </span>

          {% render 'mega-menu-mobile', menu: linklists[menu_handle] %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>

{% if left_menu != blank %}
  {% for link in left_menu.links %}
    {% if link.handle == 'shop' or link.handle == 'cook' %}
      <div
        id="mobile-menu-panel-{{ link.handle }}"
        class="mobile-menu-panel"
        data-mobile-panel="{{ link.handle }}"
        role="dialog"
        aria-modal="true"
        aria-labelledby="mobile-menu-panel-title-{{ link.handle }}"
        aria-hidden="true"
      >
        <div class="mobile-menu-panel__header">
          <button
            type="button"
            class="mobile-menu-panel__back"
            data-mobile-panel-close
            aria-label="Back to menu"
          >
            <svg
              width="20"
              height="16"
              viewBox="0 0 20 16"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M19 8H1M1 8L8 1M1 8L8 15"
                stroke="#FFFFFF"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </button>

          <h2
            id="mobile-menu-panel-title-{{ link.handle }}"
            class="mobile-menu-panel__title"
          >
            {{ link.title }}
          </h2>
        </div>

        <div class="mobile-menu-panel__content">
          {% case link.handle %}
            {% when 'shop' %}
              <div class="mobile-panel-shop">
                <h3 class="mobile-panel__section-label">Shop by category</h3>

                <nav class="mobile-panel__links" aria-label="Shop categories">
                  <a href="{{ collections['build-your-own-bundle'].url | default: '/collections/build-your-own-bundle' }}">
                    Build Your Own Bundle
                  </a>
                  <a href="{{ collections['accessories'].url | default: '/collections/accessories' }}">
                    Accessories
                  </a>
                  <a href="{{ collections['factory-seconds'].url | default: '/collections/factory-seconds' }}">
                    Factory Seconds
                  </a>
                  <a href="{{ collections['glass-lids'].url | default: '/collections/glass-lids' }}">
                    Glass lids
                  </a>
                  <a href="{{ collections['carbon-steel-lid'].url | default: '/collections/carbon-steel-lid' }}">
                    Carbon Steel Lid
                  </a>
                  <a href="{{ collections['gift-cards'].url | default: '/collections/gift-cards' }}">
                    Gift cards
                  </a>
                </nav>

                <a
                  href="{{ routes.collections_url | default: '/collections' }}"
                  class="mobile-panel__cta"
                >
                  Shop all
                </a>
              </div>

            {% when 'cook' %}
              {% assign mobile_cook_blog = blogs.recipies %}

              <div class="mobile-panel-cook">
                {% if mobile_cook_blog != blank %}
                  <h3 class="mobile-panel__section-label">Featured Recipes</h3>

                  <div class="mobile-panel-cook__featured">
                    {% for article in mobile_cook_blog.articles limit: 2 %}
                      <a href="{{ article.url }}" class="mobile-panel-cook__feature">
                        <div class="mobile-panel-cook__feature-image">
                          {% if article.image %}
                            {{
                              article.image
                              | image_url: width: 240
                              | image_tag: loading: 'lazy', alt: article.title
                            }}
                          {% endif %}
                        </div>
                        <div class="mobile-panel-cook__feature-body">
                          <span class="mobile-panel-cook__feature-title">{{ article.title }}</span>
                        </div>
                      </a>
                    {% endfor %}
                  </div>

                  <h3 class="mobile-panel__section-label">Categories</h3>

                  <nav class="mobile-panel__links" aria-label="Recipe categories">
                    <a href="{{ mobile_cook_blog.url }}/tagged/Appetizers">Appetizers</a>
                    <a href="{{ mobile_cook_blog.url }}/tagged/Sides">Sides</a>
                    <a href="{{ mobile_cook_blog.url }}/tagged/Mains">Mains</a>
                    <a href="{{ mobile_cook_blog.url }}/tagged/Desserts">Desserts</a>
                  </nav>

                  <a href="{{ mobile_cook_blog.url }}" class="mobile-panel__cta">
                    All Recipes
                  </a>
                {% endif %}
              </div>
          {% endcase %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
{% endif %}

<style>
  .mobile-menu__nav {
    width: 100%;
    background-color: #142c2a;
    position: fixed;
    top: 50px;
    left: 0;
    padding: 0 1rem;
    height: calc(100vh - 50px);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    transform: translateY(-125%);
    transition: transform 0.3s ease;
    z-index: 998;
  }
  .mobile-menu--open {
    transform: translateY(0);
  }
  .mobile-menu__nav--panel-open {
    overflow: hidden;
  }
  .mobile-menu_left__link {
    display: flex;
    flex-direction: column;
    margin: 2rem 0;
    list-style: none;
  }
  .mobile-menu__link {
    text-decoration: none;
    color: white;
    display: flex;
    justify-content: space-between;
    padding: 1.5rem 0;
    border-bottom: 2px dotted rgba(255, 255, 255, 0.3);
    cursor: pointer;
  }
  .mobile-menu__title {
    letter-spacing: 0.08em;
    line-height: 1;
    font-weight: bold;
  }
  .mobile-menu_right__list {
    display: flex;
    flex-direction: column;
    margin: 2rem 0;
    list-style: none;
  }
  .mobile-menu_right__link {
    text-decoration: none;
    color: white;
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
  }
  .mobile-menu__item svg {
    transition: transform 0.3s ease;
  }

  .mobile-menu__item.is-open svg {
    transform: rotate(-45deg);
  }

  /* Secondary Shop / Cook panels — sit just below site header */
  .mobile-menu-panel {
    position: fixed;
    top: 50px;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: calc(100dvh - 50px);
    background-color: #142c2a;
    transform: translateX(100%);
    visibility: hidden;
    transition:
      transform 0.35s ease,
      visibility 0.35s ease;
    z-index: 1000;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .mobile-menu-panel--active {
    transform: translateX(0);
    visibility: visible;
  }

  .mobile-menu-panel__header {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 85px;
    padding: 0 3rem;
    box-sizing: border-box;
  }

  .mobile-menu-panel__back {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    border: 0;
    background: none;
    color: #fff;
    cursor: pointer;
  }

  .mobile-menu-panel__title {
    margin: 0;
    letter-spacing: 0.08em;
    line-height: 1;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 20px;
    color: #fff;
    font-family: Gotham, var(--font-body), ui-sans-serif, sans-serif;
    text-align: center;
  }

  .mobile-menu-panel__content {
    flex: 1 1 auto;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0 20px;
    min-height: 0;
  }

  .mobile-panel__section-label {
    margin: 0 0 21px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    color: #b68b32;
    font-family: Gotham, var(--font-body), ui-sans-serif, sans-serif;
  }

  .mobile-panel__links {
    display: flex;
    flex-direction: column;
    gap: 17px;
    margin-bottom: 1.75rem;
  }

  .mobile-panel__links a {
    display: block;
    color: #fff;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    font-family: Gotham, var(--font-body), ui-sans-serif, sans-serif;
  }

  .mobile-panel__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 46px;
    box-sizing: border-box;
    padding: 0 1.5rem;
    background-color: #b68b32;
    color: #112626;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    font-family: Gotham, var(--font-body), ui-sans-serif, sans-serif;
    border: none;
    border-radius: 0;
  }

  /* Cook featured recipe rows */
  .mobile-panel-cook__featured {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 35px;
  }

  .mobile-panel-cook__feature {
    display: flex;
    align-items: stretch;
    width: 100%;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    background-color: #2a4140;
    border-radius: 3px;
  }

  .mobile-panel-cook__feature-image {
    flex: 0 0 5.5rem;
    width: 5.5rem;
    aspect-ratio: 1 / 1;
    background-color: #d9d9d9;
    overflow: hidden;
  }

  .mobile-panel-cook__feature-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mobile-panel-cook__feature-body {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    padding: 0.85rem 1rem;
    min-width: 0;
    background-color: #2a4140;
  }

  .mobile-panel-cook__feature-title {
    font-family: Sentinel, ui-serif, serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
    color: #fff;
  }

  @media (min-width: 920px) {
    .mobile-menu__nav,
    .mobile-menu-panel {
      display: none;
    }
  }
</style>

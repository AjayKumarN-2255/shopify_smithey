<style>
  .privacy-policy__nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
  }

  .privacy-policy__nav-item {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    width: 100%;
    margin: 0;
    min-height: 50px;
    height: 50px;
    padding: 0 1rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--privacy-policy-text);
    font-family: inherit;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
  }

  .privacy-policy__nav-item.is-active {
    background: var(--privacy-policy-active);
    color: #ffffff;
  }

  .privacy-policy__nav-icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
  }

  @media (min-width: 920px) {
    .privacy-policy__nav {
      gap: 0.45rem;
    }

    .privacy-policy__nav-item {
      min-height: 50px;
      height: 50px;
      padding: 0 0.85rem;
      font-size: 16px;
      font-weight: 400;
    }
  }
</style>

<nav class="privacy-policy__nav" aria-label="Privacy policy sections">
  <button
    type="button"
    class="privacy-policy__nav-item is-active"
    data-section="privacy-policy"
  >
    Privacy Policy
  </button>

  <button
    type="button"
    class="privacy-policy__nav-item"
    data-section="us-state-privacy"
  >
    US State Privacy Notices
  </button>

  <button
    type="button"
    class="privacy-policy__nav-item"
    data-section="privacy-request"
  >
    Make a Privacy Request
  </button>

  <button
    type="button"
    class="privacy-policy__nav-item"
    data-section="privacy-choices"
  >
    Your Privacy Choices
    <span class="privacy-policy__nav-icon" aria-hidden="true">
      <svg viewBox="0 0 18 18" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="1" y="5" width="16" height="8" rx="4" fill="#4a90e2"/>
        <circle cx="12.5" cy="9" r="3.1" fill="#ffffff"/>
        <path d="M11.35 9.05l.85.85 1.7-1.7" stroke="#4a90e2" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </button>
</nav>

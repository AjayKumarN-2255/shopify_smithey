<div class="mega-menu__grid">
  {% for link in menu.links %}
    {% case link.type %}
      {% when 'page_link' %}
        {% assign page = link.object %}

        <a href="{{ page.url }}" class="mega-menu__card">
          <div class="mega-menu__image">
            {% if page.metafields.custom.menu_image %}
              <img
                src="{{ page.metafields.custom.menu_image | image_url: width: 500 }}"
                alt="{{ page.title }}"
                width="300"
                height="220"
              >
            {% endif %}
          </div>
          <div class="mega-menu__footer">
            <h3 class="mega-menu__title">
              {{ page.title }}
            </h3>
            <p class="mega-menu__description">
              {{ page.metafields.custom.menu_description }}
            </p>
          </div>
        </a>

      {% when 'blog_link' %}
        {% assign blog = link.object %}

        <a href="{{ blog.url }}" class="mega-menu__card">
          <div class="mega-menu__image">
            {% if blog.metafields.custom.menu_image %}
              <img
                src="{{ blog.metafields.custom.menu_image | image_url: width: 500 }}"
                alt="{{ blog.title }}"
                width="300"
                height="220"
              >
            {% endif %}
          </div>
          <div class="mega-menu__footer">
            <h3 class="mega-menu__title">
              {{ blog.title }}
            </h3>
            <p class="mega-menu__description">
              {{ blog.metafields.custom.menu_description }}
            </p>
          </div>
        </a>
    {% endcase %}
  {% endfor %}
</div>

<style>
  .mega-menu__grid {
    width: 100%;
    max-width: 70rem;
    margin: 0 auto;
    display: flex;
    gap: 1rem;
    box-sizing: border-box;
    min-width: 0;
  }

  .mega-menu__card {
    flex: 1 1 0;
    min-width: 0;
    text-decoration: none;
    display: flex;
    flex-direction: row;
    height: 6.52rem;
    background-color: #2b403f;
    color: #f3f3f3;
    border-radius: 2px;
    transition: background-color 0.2s ease;
    overflow: hidden;
    box-sizing: border-box;
  }

  .mega-menu__card:hover {
    background-color: #384c49;
  }

  .mega-menu__footer {
    flex: 1 1 auto;
    min-width: 0;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    overflow: hidden;
  }

  .mega-menu__image {
    flex: 0 0 10rem;
    width: 10rem;
    height: 6.52rem;
    overflow: hidden;
  }

  .mega-menu__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mega-menu__title {
    font-size: 20px;
    text-transform: uppercase;
    margin: 0 0 0.25rem;
    color: #fff;
    line-height: 1.15;
    transition: color 0.2s ease;
  }

  .mega-menu__card:hover .mega-menu__title {
    color: #b68b32;
  }

  .mega-menu__description {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.05em;
    max-width: 16rem;
  }

  /* 1024–1200 — keep horizontal cards, shrink + clip text so all 3 fit */
  @media (min-width: 1024px) and (max-width: 1200px) {
    .mega-menu__grid {
      gap: 0.65rem;
      max-width: 100%;
    }

    .mega-menu__card {
      height: 5.75rem;
      flex-direction: row;
    }

    .mega-menu__image {
      flex: 0 0 5.75rem;
      width: 5.75rem;
      height: 5.75rem;
    }

    .mega-menu__footer {
      padding: 0.55rem 0.7rem;
      overflow: hidden;
    }

    .mega-menu__title {
      font-size: 13px;
      line-height: 1.2;
      margin-bottom: 0.2rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .mega-menu__description {
      font-size: 10px;
      line-height: 1.3;
      letter-spacing: 0.02em;
      max-width: 100%;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      text-overflow: ellipsis;
      word-break: break-word;
    }
  }

  @media (min-width: 920px) and (max-width: 1023px) {
    .mega-menu__grid {
      gap: 0.5rem;
      max-width: 100%;
    }

    .mega-menu__card {
      height: 5.25rem;
      flex-direction: row;
    }

    .mega-menu__image {
      flex: 0 0 5.25rem;
      width: 5.25rem;
      height: 5.25rem;
    }

    .mega-menu__footer {
      padding: 0.45rem 0.55rem;
      overflow: hidden;
    }

    .mega-menu__title {
      font-size: 12px;
      line-height: 1.2;
      margin-bottom: 0.15rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .mega-menu__description {
      font-size: 9px;
      line-height: 1.25;
      letter-spacing: 0.02em;
      max-width: 100%;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      text-overflow: ellipsis;
      word-break: break-word;
    }
  }
</style>

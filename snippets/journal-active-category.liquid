{% comment %}
  Resolves the active journal category for filtering.

  Uses supported Liquid only (works on published storefronts):
  1. template.suffix from ?view=care|craft|culinary|smithey-stories
  2. current_tags from /blogs/.../tagged/...
  3. /tagged/ segment via request.path

  Does not use content_for_header / pageurl (unreliable in production).
  Usage: {% capture active_category %}{% render 'journal-active-category' %}{% endcapture %}
{% endcomment %}

{%- liquid
  assign value = blank
  assign suffix = template.suffix | strip | downcase

  if template.name == 'blog' and suffix != blank and suffix != 'recipies'
    assign value = suffix
  elsif current_tags.size > 0
    assign value = current_tags.first
  elsif request.path contains '/tagged/'
    assign value = request.path | split: '/tagged/' | last | split: '/' | first | url_decode
  endif

  echo value | replace: '-', ' ' | strip | downcase
-%}

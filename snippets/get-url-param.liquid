{% comment %}
  Reads a query string parameter from the current page URL.
  Accepts:
  - key: {String} Query parameter name
  Usage:
  {% render 'get-url-param', key: 'shape' %}
{% endcomment %}

{%- liquid
  capture content_for_query_string
    echo content_for_header
  endcapture

  assign page_url = content_for_query_string | split: '"pageurl":"' | last | split: '"' | first | split: '.myshopify.com' | last | replace: '\/', '/' | replace: '%20', ' ' | replace: '\u0026', '&'
  assign query_string = page_url | split: '?' | last
  assign param_value = blank

  if page_url contains '?'
    assign query_parts = query_string | split: '&'
    assign key_downcase = key | downcase

    for part in query_parts
      assign pair = part | split: '='
      if pair.size > 1
        assign pair_key = pair[0] | downcase
        if pair_key == key_downcase
          assign param_value = pair[1] | url_decode
          break
        endif
      endif
    endfor
  endif

  echo param_value
-%}

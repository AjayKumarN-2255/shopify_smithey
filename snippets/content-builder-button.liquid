{% assign selector = '#content-builder-button-' | append: block.id %}

<div
  id="content-builder-button-{{ block.id }}"
  class="
    content-builder__button
    content-builder__button--desktop-{{ block.settings.btn_position_desktop }}
    content-builder__button--mobile-{{ block.settings.btn_position_mobile }}
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.button_text != blank and block.settings.button_link != blank %}
    <a
      href="{{ block.settings.button_link }}"
      class="content-builder__button-link"
      style="
        background-color: {{ block.settings.button_bg_color }};
        color: {{ block.settings.button_text_color }};
      "
    >
      {{ block.settings.button_text }}
    </a>
  {% endif %}
</div>

<style>
  {{ selector }} {
    width: 100%;
    display: flex;
    margin-top: 1.5rem;
  }

  {{ selector }}.content-builder__button--mobile-left {
    justify-content: flex-start;
  }

  {{ selector }}.content-builder__button--mobile-center {
    justify-content: center;
  }

  {{ selector }}.content-builder__button--mobile-right {
    justify-content: flex-end;
  }

  {{ selector }} .content-builder__button-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 2rem;
    text-decoration: none;
    font-weight: bold;
    margin: 1rem 0;
  }

  {{ selector }} .content-builder__button-link:hover {
    opacity: 0.9;
  }

  @media (min-width: 920px) {
    {{ selector }}.content-builder__button--desktop-left {
      justify-content: flex-start;
    }

    {{ selector }}.content-builder__button--desktop-center {
      justify-content: center;
    }

    {{ selector }}.content-builder__button--desktop-right {
      justify-content: flex-end;
    }

    {{ selector }} .content-builder__button-link {
      font-size: 0.9rem;
    }
  }

  {{ block.settings.custom_css | replace: '&', selector }}
</style>

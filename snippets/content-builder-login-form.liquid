    background-color: #be893d;
    border: 0;
    border-radius: 0;
    padding: 0 1.75rem;
    color: #2b2b2b;
    font-family: var(--font-heading), ui-serif, serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 47px;
    cursor: pointer;
  }

  .login-form__button:hover {
    opacity: 0.9;
  }

  .login-form__forgot-password {
    color: #8a8a8a;
    font-family: var(--font-heading), ui-serif, serif;

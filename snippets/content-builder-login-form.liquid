<form
  method="post"
  action="/account/login"
  id="login-form"
  class="login-form"
>
  <div class="login-form__field">
    <input
      id="CustomerEmail"
      type="email"
      name="customer[email]"
      class="login-form__input"
      placeholder="Email"
      autocomplete="email"
      required
    >
  </div>

  <div class="login-form__field">
    <input
      id="CustomerPassword"
      type="password"
      name="customer[password]"
      class="login-form__input"
      placeholder="Password"
      autocomplete="current-password"
      required
    >
  </div>

  <div class="login-form__password-actions">
    <button
      type="submit"
      class="login-form__button"
    >
      Sign in
    </button>
    <a
      href="{{ routes.account_recover_url }}"
      class="login-form__forgot-password"
    >
      Forgot your password?
    </a>
  </div>
</form>

<style>
  .login-form {

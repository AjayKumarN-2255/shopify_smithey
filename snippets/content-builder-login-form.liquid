    appearance: none;
    -webkit-appearance: none;
    background-color: #ffffff;
    border: 1px solid #6b6b6b;
    border-radius: 0;
    padding: 0 1rem;
    color: #3d3d3d;
    font-family: var(--font-heading), ui-serif, serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 45px;
    outline: none;
    box-shadow: none;
  }

  .login-form__input::placeholder {
    color: #4a4a4a;
    opacity: 1;
    font-family: var(--font-heading), ui-serif, serif;
    font-size: 13px;
  }

  .login-form__input:focus {
    border-color: #333333;
  }


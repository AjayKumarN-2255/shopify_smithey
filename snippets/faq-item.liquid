{% assign selector = '#content-builder-faq-' | append: block.id %}

<div
  id="content-builder-faq-{{ block.id }}"
  class="faq__item"
  {{ block.shopify_attributes }}
>
  <div class="faq__question">
    <span class="faq__question-text">
      {{ block.settings.question }}
    </span>

    <span class="faq__icon">+</span>
    <span class="faq__icon faq-hide">−</span>
  </div>

  <div class="faq__answer">
    {{ block.settings.answer }}
  </div>
</div>

<style>
  .faq__item {
    width: 100%;
    border-top: 3px solid #000;
    padding: 1rem 0;
  }

  .faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }

  .faq-hide {
    display: none;
  }

  .faq__question-text,
  .faq__icon {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.7px;
    line-height: 1.05;
    color: #b68b32;
    cursor: pointer;
  }

  .faq__answer {
    font-size: 14px;
    line-height: 20px;
    color: #112626;
    font-weight: 500;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, margin 0.3s ease;
    margin: 0;
  }

  .faq__item.is-open .faq__answer {
    max-height: 500px;
    margin: 1rem 0;
  }

  .faq__item.is-open .faq__icon:not(.faq-hide) {
    display: none;
  }

  .faq__item.is-open .faq__icon.faq-hide {
    display: inline;
  }

  @media (min-width: 920px) {
    .faq__question-text,
    .faq__icon {
      font-size: 22px;
    }

    .faq__answer {
      font-size: 20px;
      line-height: 28px;
    }
  }
</style>

{% if block.settings.custom_css != blank %}
  <style>
    {{ block.settings.custom_css | replace: '&', selector }}
  </style>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const item = document.getElementById('content-builder-faq-{{ block.id }}');
    if (!item) return;

    const question = item.querySelector('.faq__question');
    if (!question || question.dataset.faqBound === 'true') return;

    question.dataset.faqBound = 'true';
    question.setAttribute('role', 'button');
    question.setAttribute('tabindex', '0');
    question.setAttribute('aria-expanded', 'false');

    const toggleFaq = () => {
      const isOpen = item.classList.contains('is-open');
      const scope =
        item.closest('.faq__items') ||
        item.closest('.faq-categories__items') ||
        item.closest('.content-builder') ||
        item.parentElement;

      if (scope) {
        scope.querySelectorAll('.faq__item').forEach((faq) => {
          faq.classList.remove('is-open');
          const faqQuestion = faq.querySelector('.faq__question');
          if (faqQuestion) faqQuestion.setAttribute('aria-expanded', 'false');
        });
      }

      if (!isOpen) {
        item.classList.add('is-open');
        question.setAttribute('aria-expanded', 'true');
      }
    };

    question.addEventListener('click', toggleFaq);
    question.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggleFaq();
      }
    });
  });
</script>

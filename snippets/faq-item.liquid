{% assign selector = '#content-builder-faq-' | append: block.id %}

<div
  id="content-builder-faq-{{ block.id }}"
  class="faq__item{% if block.settings.open_by_default %} is-open{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="faq__question">
    <span class="faq__question-text">
      {{ block.settings.question }}
    </span>

    <span class="faq__icon" aria-hidden="true">
      <svg class="faq__icon-plus" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="11" cy="11" r="11" fill="white" fill-opacity="0.66"></circle>
        <path d="M5.5 11H16.5" stroke="#B68B32" stroke-width="2" stroke-linejoin="round"></path>
        <path d="M11 5.5V16.5" stroke="#B68B32" stroke-width="2" stroke-linejoin="round"></path>
      </svg>
      <svg class="faq__icon-minus" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="11" cy="11" r="11" fill="white" fill-opacity="0.66"></circle>
        <path d="M16.5 11L5.5 11" stroke="#B68B32" stroke-width="2" stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>

  <div class="faq__answer">
    {{ block.settings.answer }}
  </div>
</div>

<style>
  .faq__item {
    width: 100%;
    border-top: 3px solid #000;
    padding: 1rem 0;
  }

  .faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }

  .faq-hide {
    display: none;
  }

  .faq__question-text,
  .faq__icon {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.7px;
    line-height: 1.05;
    color: #b68b32;
    cursor: pointer;
  }

  .faq__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    line-height: 0;
  }

  .faq__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .faq__icon .faq__icon-minus {
    display: none;
  }

  .faq__item.is-open .faq__icon .faq__icon-plus {
    display: none;
  }

  .faq__item.is-open .faq__icon .faq__icon-minus {
    display: block;
  }

  @media (max-width: 919px) {
    .faq__icon {
      width: 20px;
      height: 20px;
      line-height: 0;
      letter-spacing: 0;
      flex: 0 0 auto;
    }
  }

  .faq__answer {
    font-size: 14px;
    line-height: 20px;
    color: #112626;
    font-weight: 500;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, margin 0.3s ease;
    margin: 0;
  }

  .faq__item.is-open .faq__answer {
    max-height: 500px;
    margin: 1rem 0;
  }

  @media (min-width: 920px) {
    .faq__question-text,
    .faq__icon {
      font-size: 22px;
    }

    .faq__icon {
      width: 22px;
      height: 22px;
    }

    .faq__answer {
      font-size: 20px;
      line-height: 28px;
    }

    .faq__item:last-child {
      margin-bottom: 4rem;
    }
  }
</style>

{% if block.settings.custom_css != blank %}
  <style>
    {{ block.settings.custom_css | replace: '&', selector }}
  </style>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const item = document.getElementById('content-builder-faq-{{ block.id }}');
    if (!item) return;

    const question = item.querySelector('.faq__question');
    if (!question || question.dataset.faqBound === 'true') return;

    question.dataset.faqBound = 'true';
    question.setAttribute('role', 'button');
    question.setAttribute('tabindex', '0');
    question.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');

    const getFaqScope = () =>
      item.closest('.faq__items') ||
      item.closest('.faq-categories__items') ||
      item.closest('.content-builder__right') ||
      item.closest('.content-builder__left') ||
      item.closest('.content-builder') ||
      item.parentElement;

    const toggleFaq = () => {
      const isOpen = item.classList.contains('is-open');
      const scope = getFaqScope();

      if (scope) {
        scope.querySelectorAll('.faq__item').forEach((faq) => {
          faq.classList.remove('is-open');
          const faqQuestion = faq.querySelector('.faq__question');
          if (faqQuestion) faqQuestion.setAttribute('aria-expanded', 'false');
        });
      }

      if (!isOpen) {
        item.classList.add('is-open');
        question.setAttribute('aria-expanded', 'true');
      }
    };

    question.addEventListener('click', toggleFaq);
    question.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggleFaq();
      }
    });
  });
</script>

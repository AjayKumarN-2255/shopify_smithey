        <p class="privacy-policy__text">We generally retain data according to the guidelines below.</p>
        <div class="privacy-policy__table-wrap">
          <table class="privacy-policy__table">
            <caption>Data Retention</caption>
            <thead>
              <tr>
                <th scope="col" width="40%">Type of Data</th>
                <th scope="col" width="60%">Retention Period</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>

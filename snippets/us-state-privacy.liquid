<style>
  .us-state-privacy {
    width: 100%;
  }

  .us-state-privacy__title {
    margin: 0 0 1.5rem;
    color: var(--privacy-policy-text, #1a1a1a);
    font-family: var(--font-body);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .us-state-map {
    display: none;
    width: 100%;
    overflow: visible;
  }

  .us-state-map__grid {
    display: grid;
    grid-template-columns: repeat(12, 46px);
    grid-template-rows: repeat(8, 46px);
    gap: 8px;
    width: max-content;
    max-width: 720px;
    margin: 0 auto;
    padding: 12px;
    overflow: visible;
  }

  .us-state-map__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 8px;
    background: #fff;
    color: #716e82;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 0 2px 4px rgba(113, 110, 130, 0.25), 0 4px 10px rgba(113, 110, 130, 0.3),
      0 8px 18px rgba(113, 110, 130, 0.2);
    pointer-events: none;
  }

  a.us-state-map__cell {
    background: #716e82;
    color: #fff;
    pointer-events: auto;
    box-shadow: 0 2px 4px rgba(113, 110, 130, 0.25), 0 4px 10px rgba(113, 110, 130, 0.3),
      0 8px 18px rgba(113, 110, 130, 0.2);
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }

  a.us-state-map__cell:hover,
  a.us-state-map__cell:focus-visible {
    background: #4f4d5c;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 2px 4px rgba(113, 110, 130, 0.25), 0 4px 10px rgba(113, 110, 130, 0.3),
      0 8px 18px rgba(113, 110, 130, 0.2);
    outline: none;
  }

  .us-state-privacy .privacy-policy__accordion {
    width: 100%;
  }

  .us-state-privacy .privacy-policy__accordion + .privacy-policy__accordion {
    margin-top: 1.5rem;
  }

  .us-state-privacy .privacy-policy__accordion-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    margin: 0;
    min-height: 70px;
    height: 70px;
    padding: 0 1.15rem;
    border: 0;
    border-radius: 8px;
    background: var(--privacy-policy-accordion, #e8e5ee);
    color: var(--privacy-policy-text, #1a1a1a);
    font-family: inherit;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.35;
    text-align: left;
    cursor: pointer;
  }

  .us-state-privacy .privacy-policy__accordion-title {
    min-width: 0;
    flex: 1;
  }

  .us-state-privacy .privacy-policy__accordion-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: #4a4a4a;
    transition: transform 0.2s ease;
  }

  .us-state-privacy .privacy-policy__accordion.is-open .privacy-policy__accordion-header {
    background: var(--privacy-policy-active, #716e82);
    color: #ffffff;
  }

  .us-state-privacy .privacy-policy__accordion.is-open .privacy-policy__accordion-icon {
    color: #ffffff;
    transform: rotate(90deg);
  }

  .us-state-privacy .privacy-policy__accordion-content {
    display: none;
    padding: 1rem 0.15rem 0.35rem;
  }

  .us-state-privacy .privacy-policy__accordion.is-open .privacy-policy__accordion-content {
    display: block;
  }

  .us-state-privacy .privacy-policy__section {
    width: 100%;
  }

  .us-state-privacy .privacy-policy__section + .privacy-policy__section {
    margin-top: 1.75rem;
  }

  .us-state-privacy .privacy-policy__section-heading {
    margin: 0 0 0.75rem;
    color: var(--privacy-policy-text, #1a1a1a);
    font-family: inherit;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
  }

  .us-state-privacy .privacy-policy__section-heading a {
    color: inherit;
    text-decoration: none;
  }

  .us-state-privacy .privacy-policy__text {
    margin: 0;
    color: var(--privacy-policy-text, #1a1a1a);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
  }

  .us-state-privacy .privacy-policy__text + .privacy-policy__text {
    margin-top: 1rem;
  }

  .us-state-privacy .privacy-policy__text a {
    color: var(--privacy-policy-text, #1a1a1a);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .us-state-privacy .privacy-policy__list {
    margin: 1rem 0 0;
    padding: 0 0 0 1.25rem;
    color: var(--privacy-policy-text, #1a1a1a);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    list-style: disc;
  }

  .us-state-privacy .privacy-policy__list-item {
    margin: 0 0 0.55rem;
    padding-left: 0.15rem;
  }

  .us-state-privacy .privacy-policy__list-item:last-child {
    margin-bottom: 0;
  }

  .us-state-privacy .privacy-policy__list--columns {
    column-count: 1;
    column-gap: 2.5rem;
  }

  .us-state-privacy .privacy-policy__list--columns .privacy-policy__list-item {
    break-inside: avoid;
  }

  .us-state-privacy .privacy-policy__table-wrap {
    width: 100%;
    margin-top: 1.25rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .us-state-privacy .privacy-policy__table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    border: 1px solid #1a1a1a;
    table-layout: fixed;
    color: var(--privacy-policy-text, #1a1a1a);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.55;
    text-align: left;
  }

  .us-state-privacy .privacy-policy__table caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .us-state-privacy .privacy-policy__table th,
  .us-state-privacy .privacy-policy__table td {
    padding: 0.9rem 1rem;
    border: 1px solid #1a1a1a;
    vertical-align: top;
  }

  .us-state-privacy .privacy-policy__table thead th {
    background: #e5e7eb;
    font-weight: 700;
  }

  .us-state-privacy .privacy-policy__table tbody tr:nth-child(odd) td {
    background: #f5f4f9;
  }

  .us-state-privacy .privacy-policy__table tbody tr:nth-child(even) td {
    background: #ffffff;
  }

  .us-state-privacy .privacy-policy__table--disclose {
    min-width: 48rem;
  }

  @media (min-width: 920px) {
    .us-state-privacy__title {
      margin-bottom: 2rem;
      font-size: 32px;
      font-weight: 500;
    }

    .us-state-map {
      display: block;
      width: 100%;
      margin-bottom: 2rem;
    }

    .us-state-privacy .privacy-policy__accordion + .privacy-policy__accordion {
      margin-top: 1.2rem;
    }

    .us-state-privacy .privacy-policy__accordion-header {
      min-height: 70px;
      height: 70px;
      padding: 0 1.5rem;
      border-radius: 8px;
      font-size: 20px;
      font-weight: 400;
    }

    .us-state-privacy .privacy-policy__accordion-content {
      padding: 1.1rem 0.25rem 0.4rem;
    }

    .us-state-privacy .privacy-policy__section + .privacy-policy__section {
      margin-top: 2.25rem;
    }

    .us-state-privacy .privacy-policy__section-heading {
      margin-bottom: 0.85rem;
      font-size: 24px;
    }

    .us-state-privacy .privacy-policy__text {
      font-size: 16px;
      line-height: 1.55;
    }

    .us-state-privacy .privacy-policy__list {
      margin-top: 1.15rem;
      padding-left: 1.5rem;
      font-size: 16px;
      line-height: 1.55;
    }

    .us-state-privacy .privacy-policy__list-item {
      margin-bottom: 0.4rem;
    }

    .us-state-privacy .privacy-policy__list--columns {
      column-count: 2;
      column-gap: 3rem;
    }

    .us-state-privacy .privacy-policy__table-wrap {
      margin-top: 1.5rem;
      overflow-x: visible;
    }

    .us-state-privacy .privacy-policy__table {
      min-width: 0;
      font-size: 16px;
    }

    .us-state-privacy .privacy-policy__table th,
    .us-state-privacy .privacy-policy__table td {
      padding: 1rem 1.15rem;
    }
  }
</style>


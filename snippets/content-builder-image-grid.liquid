<div
  id="content-builder-image-grid-{{ block.id }}"
  class="content-builder__image-grid"
  {{ block.shopify_attributes }}
>
  {% if block.settings.image_1 != blank %}
    <div class="content-builder__image-grid-item">
      <img
        src="{{ block.settings.image_1 | image_url: width: 1000 }}"
        alt="Content image"
        width="{{ block.settings.image_1.width }}"
        height="{{ block.settings.image_1.height }}"
      >
    </div>
  {% endif %}

  {% if block.settings.image_2 != blank %}
    <div class="content-builder__image-grid-item">
      <img
        src="{{ block.settings.image_2 | image_url: width: 1000 }}"
        alt="Content image"
        width="{{ block.settings.image_2.width }}"
        height="{{ block.settings.image_2.height }}"
      >
    </div>
  {% endif %}
</div>

{% assign selector = '#content-builder-image-grid-' | append: block.id %}

<style>
  #content-builder-image-grid-{{ block.id }} {
    width: 100%;
    display: flex;
    gap: 1rem;
    height: {{ block.settings.grid_mobile_height }}rem;
  }

  #content-builder-image-grid-{{ block.id }} .content-builder__image-grid-item {
    flex: 1;
    width: 50%;
    height: 100%;
  }

  #content-builder-image-grid-{{ block.id }} .content-builder__image-grid-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 920px) {
    #content-builder-image-grid-{{ block.id }} {
      height: {{ block.settings.grid_desktop_height }}rem;
      margin-top: 4rem;
    }
  }

  @media (min-width: 1700px) {
    #content-builder-image-grid-{{ block.id }} {
      height: {{ block.settings.grid_large_desktop_height }}rem;
      margin-top: 4rem;
    }
  }

  {{ block.settings.custom_css | replace: '&', selector }}
</style>

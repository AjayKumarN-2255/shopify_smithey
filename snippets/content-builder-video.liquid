{% liquid
  assign mobile_height = block.settings.video_mobile_height | default: block.settings.mobile_height | default: 20
  assign desktop_height = block.settings.video_desktop_height | default: block.settings.desktop_height | default: 30
  assign large_desktop_height = block.settings.video_large_desktop_height | default: block.settings.large_desktop_height | default: 36
  assign autoplay = block.settings.autoplay
  assign muted = block.settings.muted
  assign loop = block.settings.loop
  assign play_behavior = block.settings.play_behavior | default: 'standard'
  assign show_controls = true
  assign has_poster = false

  if block.settings.poster != blank
    assign has_poster = true
  endif

  if block.settings.show_controls == false
    assign show_controls = false
  endif

  if autoplay
    assign muted = true
  endif

  if has_poster or play_behavior == 'click_to_play'
    assign autoplay = false
  endif

  assign has_video = false
  if block.settings.video != blank or block.settings.video_url != blank
    assign has_video = true
  endif
%}

{% if has_video %}
  <div
    id="content-builder-video-{{ block.id }}"
    class="content-builder-video{% if has_poster or play_behavior == 'click_to_play' %} content-builder-video--click-to-play{% endif %}"
    {{ block.shopify_attributes }}
  >
    <div class="content-builder-video__container">
      {% if block.settings.video != blank %}
        {{
          block.settings.video
          | video_tag:
            image_size: '2000x',
            autoplay: autoplay,
            loop: loop,
            controls: show_controls,
            muted: muted,
            class: 'content-builder-video__video'
        }}
      {% elsif block.settings.video_url != blank %}
        <video
          class="content-builder-video__video"
          playsinline
          {% if autoplay %}
            autoplay
          {% endif %}
          {% if muted %}
            muted
          {% endif %}
          {% if loop %}
            loop
          {% endif %}
          {% if show_controls %}
            controls
          {% endif %}
        >
          <source
            src="{{ block.settings.video_url }}"
            type="video/mp4"
          >
        </video>
      {% endif %}

      {% if has_poster %}
        <button
          type="button"
          class="content-builder-video__thumbnail"
          aria-label="Play video"
        >
          <img
            class="content-builder-video__thumbnail-image"
            src="{{ block.settings.poster | image_url: width: 2000 }}"
            alt="{{ block.settings.poster.alt | default: 'Video thumbnail' | escape }}"
            width="{{ block.settings.poster.width }}"
            height="{{ block.settings.poster.height }}"
            loading="lazy"
          >
          <span class="content-builder-video__play" aria-hidden="true">
            <svg
              class="content-builder-video__play-icon"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </span>
        </button>
      {% elsif play_behavior == 'click_to_play' %}
        <button
          type="button"
          class="content-builder-video__play"
          aria-label="Play video"
        >
          <svg
            class="content-builder-video__play-icon"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </button>
      {% endif %}

      {% if block.settings.show_overlay %}
        <div class="content-builder-video__overlay"></div>
      {% endif %}
    </div>

    {% if has_poster or play_behavior == 'click_to_play' %}
      <div
        class="content-builder-video__modal"
        id="content-builder-video-modal-{{ block.id }}"
        hidden
        aria-hidden="true"
      >
        <div class="content-builder-video__modal-inner">
          <button
            type="button"
            class="content-builder-video__modal-close"
            aria-label="Close video"
          >
            <svg
              class="content-builder-video__modal-close-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M5 5l14 14M19 5 5 19"></path>
            </svg>
          </button>
          <div class="content-builder-video__modal-player"></div>
        </div>
      </div>
    {% endif %}
  </div>

  {% if has_poster or play_behavior == 'click_to_play' %}
    <script>
      (function () {
        const root = document.getElementById('content-builder-video-{{ block.id }}');
        if (!root || root.dataset.videoBound === 'true') return;
        root.dataset.videoBound = 'true';

        const container = root.querySelector('.content-builder-video__container');
        const video = root.querySelector('.content-builder-video__video');
        const trigger =
          root.querySelector('.content-builder-video__thumbnail') ||
          root.querySelector('.content-builder-video__play');
        const modal = document.getElementById('content-builder-video-modal-{{ block.id }}');
        const modalPlayer = modal && modal.querySelector('.content-builder-video__modal-player');
        const modalClose = modal && modal.querySelector('.content-builder-video__modal-close');

        if (!video || !trigger || !container || !modal || !modalPlayer) return;

        document.body.appendChild(modal);

        const desktopQuery = window.matchMedia('(min-width: 920px)');
        let isModalOpen = false;

        const syncInlineState = () => {
          if (isModalOpen) return;
          root.classList.toggle('is-playing', !video.paused);
        };

        const openModal = () => {
          if (isModalOpen) return;
          isModalOpen = true;
          modal.hidden = false;
          modal.setAttribute('aria-hidden', 'false');
          modal.classList.add('is-open');
          document.body.classList.add('content-builder-video-modal-open');
          modalPlayer.appendChild(video);
          video.play();
        };

        const closeModal = () => {
          if (!isModalOpen) return;
          isModalOpen = false;
          video.pause();
          container.insertBefore(video, container.firstChild);
          modal.classList.remove('is-open');
          modal.hidden = true;
          modal.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('content-builder-video-modal-open');
          root.classList.remove('is-playing');
        };

        trigger.addEventListener('click', () => {
          if (desktopQuery.matches) {
            openModal();
            return;
          }
          video.play();
        });

        if (modalClose) {
          modalClose.addEventListener('click', closeModal);
        }

        modal.addEventListener('click', (event) => {
          if (event.target === modal) closeModal();
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && isModalOpen) closeModal();
        });

        video.addEventListener('play', syncInlineState);
        video.addEventListener('pause', syncInlineState);
        video.addEventListener('ended', syncInlineState);

        desktopQuery.addEventListener('change', (event) => {
          if (!event.matches && isModalOpen) closeModal();
        });
      })();
    </script>
  {% endif %}
{% endif %}

{% assign selector = '#content-builder-video-' | append: block.id %}

<style>
  #content-builder-video-{{ block.id }} {
    width: 100%;
    height: {{ mobile_height }}rem;
    margin: 1rem 0;
  }

  #content-builder-video-{{ block.id }} .content-builder-video__container {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  #content-builder-video-{{ block.id }} .content-builder-video__video,
  #content-builder-video-{{ block.id }} video,
  #content-builder-video-{{ block.id }} iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #content-builder-video-{{ block.id }} .content-builder-video__thumbnail {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: transparent;
    cursor: pointer;
  }

  #content-builder-video-{{ block.id }} .content-builder-video__thumbnail-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.35s ease;
  }

  #content-builder-video-{{ block.id }} .content-builder-video__thumbnail:hover .content-builder-video__thumbnail-image {
    transform: scale(1.05);
  }

  #content-builder-video-{{ block.id }} .content-builder-video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: #000000;
    color: #ffffff;
    transform: translate(-50%, -50%);
    cursor: pointer;
    pointer-events: none;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  #content-builder-video-{{ block.id }} .content-builder-video__thumbnail:hover .content-builder-video__play,
  #content-builder-video-{{ block.id }} button.content-builder-video__play:hover {
    background-color: #b68b32;
    color: #112626;
  }

  #content-builder-video-{{ block.id }} .content-builder-video__play-icon {
    width: 1.1rem;
    height: 1.1rem;
    transform: translateX(2px);
  }

  @media (min-width: 920px) {
    #content-builder-video-{{ block.id }} .content-builder-video__play {
      width: 3.5rem;
      height: 3.5rem;
    }

    #content-builder-video-{{ block.id }} .content-builder-video__play-icon {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  #content-builder-video-{{ block.id }} button.content-builder-video__play {
    pointer-events: auto;
  }

  #content-builder-video-{{ block.id }}.is-playing .content-builder-video__thumbnail,
  #content-builder-video-{{ block.id }}.is-playing .content-builder-video__play {
    display: none;
  }

  #content-builder-video-{{ block.id }} .content-builder-video__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(17 38 38 / {{ block.settings.overlay_opacity | default: 35 }}%);
    pointer-events: none;
  }

  #content-builder-video-modal-{{ block.id }} {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99999;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(0, 0, 0, 0.72);
  }

  #content-builder-video-modal-{{ block.id }}.is-open {
    display: flex;
  }

  #content-builder-video-modal-{{ block.id }} .content-builder-video__modal-inner {
    position: relative;
    width: 100%;
    max-width: 1024px;
  }

  #content-builder-video-modal-{{ block.id }} .content-builder-video__modal-close {
    position: absolute;
    bottom: 100%;
    right: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 0.5rem;
    padding: 0.25rem;
    border: 0;
    background: transparent;
    color: #ffffff;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  #content-builder-video-modal-{{ block.id }} .content-builder-video__modal-close:hover {
    color: #b68b32;
  }

  #content-builder-video-modal-{{ block.id }} .content-builder-video__modal-close-icon {
    width: 1.25rem;
    height: 1.25rem;
    display: block;
  }

  #content-builder-video-modal-{{ block.id }} .content-builder-video__modal-player {
    width: 100%;
    max-width: 1024px;
    height: auto;
    aspect-ratio: 16 / 9;
    max-height: 576px;
    background: #000000;
  }

  #content-builder-video-modal-{{ block.id }} .content-builder-video__modal-player .content-builder-video__video,
  #content-builder-video-modal-{{ block.id }} .content-builder-video__modal-player video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  @media (min-width: 920px) {
    #content-builder-video-{{ block.id }} {
      height: {{ desktop_height }}rem;
      margin-top: 0;
    }

    #content-builder-video-modal-{{ block.id }} .content-builder-video__modal-player {
      height: 576px;
      max-height: 576px;
      aspect-ratio: auto;
    }
  }

  @media (min-width: 1700px) {
    #content-builder-video-{{ block.id }} {
      height: {{ large_desktop_height }}rem;
      margin-top: 0;
    }
  }

  body.content-builder-video-modal-open {
    overflow: hidden;
  }

  {{ block.settings.custom_css | replace: '&', selector }}
</style>

<div
  id="content-builder-video-{{ block.id }}"
  class="content-builder-video"
  {{ block.shopify_attributes }}
>
  <div class="content-builder-video__wrapper">
    {% if block.settings.video != blank %}
      {{
        block.settings.video
        | video_tag:
          image_size: '1600x',
          autoplay: false,
          loop: false,
          controls: true,
          muted: false,
          poster: block.settings.poster
      }}

    {% elsif block.settings.video_url != blank %}
      <video
        controls
        playsinline
        poster="{{ block.settings.poster | image_url }}"
      >
        <source src="{{ block.settings.video_url }}" type="video/mp4">
      </video>
    {% endif %}

    {% if block.settings.show_overlay %}
      <div class="content-builder-video__overlay"></div>
    {% endif %}
  </div>
</div>
<style>
  .content-builder-video{
    padding:1rem 0 2rem 0;
  }
  #content-builder-video-{{ block.id }} .content-builder-video__wrapper {
    position: relative;
    overflow: hidden;
    height: {{ block.settings.mobile_height }}rem;
  }

  #content-builder-video-{{ block.id }} video,
  #content-builder-video-{{ block.id }} iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #content-builder-video-{{ block.id }} .content-builder-video__overlay {
    position: absolute;
    inset: 0;
    background: rgb(17 38 38 / {{ block.settings.overlay_opacity }}%);
    pointer-events: none;
  }

  @media (min-width: 920px) {
    #content-builder-video-{{ block.id }} .content-builder-video__wrapper {
      height: {{ block.settings.desktop_height }}rem;
    }
    .content-builder-video{
      padding:2rem 0 0 0;
    }
  }

  @media (min-width: 1700px) {
    #content-builder-video-{{ block.id }} .content-builder-video__wrapper {
      height: {{ block.settings.large_desktop_height }}rem;
    }
    .content-builder-video{
      padding:1rem 0 0 0;
    }
  }
</style>

<div class="privacy-policy__privacy-request">
  <div class="privacy-request__inner">
    <div class="privacy-request__header">
      <h2 class="privacy-request__title">Privacy Request</h2>

      <div class="privacy-request__lang">
        <select class="privacy-request__lang-select" aria-label="Language">
          <option value="en" selected>English</option>
          <option value="de">Deutsch</option>
          <option value="es">Español</option>
          <option value="fr">Français</option>
          <option value="it">Italiano</option>
          <option value="nl">Nederlands</option>
          <option value="no">Norsk</option>
          <option value="sv">Svenska</option>
        </select>
      </div>
    </div>

    <p class="privacy-request__intro">
      Submit this form to make a Privacy Request. To exercise your right to opt-out of data selling/sharing, visit
      <a href="/opt-out">Your Privacy Choices</a>. To better understand your rights, you can review our
      <a href="/privacy-policy">Privacy Policy</a>.
    </p>

    <form class="privacy-request__form">
      <div class="privacy-request__field">
        <label class="privacy-request__field-label" for="privacy-request-state">State</label>
        <select class="privacy-request__control" id="privacy-request-state" name="state">
          <option value="" disabled selected>Select a state</option>
          <option value="US-CA">California</option>
          <option value="US-CO">Colorado</option>
          <option value="US-CT">Connecticut</option>
          <option value="US-DE">Delaware</option>
          <option value="US-IN">Indiana</option>
          <option value="US-IA">Iowa</option>
          <option value="US-KY">Kentucky</option>
          <option value="US-MD">Maryland</option>
          <option value="US-MN">Minnesota</option>
          <option value="US-MT">Montana</option>
          <option value="US-NE">Nebraska</option>
          <option value="US-NV">Nevada</option>
          <option value="US-NH">New Hampshire</option>
          <option value="US-NJ">New Jersey</option>
          <option value="US-OR">Oregon</option>
          <option value="US-RI">Rhode Island</option>
          <option value="US-TN">Tennessee</option>
          <option value="US-TX">Texas</option>
          <option value="US-UT">Utah</option>
          <option value="US-VA">Virginia</option>
        </select>
      </div>

      <div class="privacy-request__field">
        <label class="privacy-request__field-label" for="privacy-request-type">Request Type</label>
        <select class="privacy-request__control" id="privacy-request-type" name="dataRequestType" disabled>
          <option value="" disabled selected>Select region/state first</option>
        </select>
      </div>

      <div class="privacy-request__name-row">
        <div class="privacy-request__field">
          <label class="privacy-request__field-label" for="privacy-request-first-name">First Name</label>
          <input class="privacy-request__control" id="privacy-request-first-name" required type="text" name="firstName">
        </div>

        <div class="privacy-request__field">
          <label class="privacy-request__field-label" for="privacy-request-last-name">Last Name</label>
          <input class="privacy-request__control" id="privacy-request-last-name" required type="text" name="lastName">
        </div>
      </div>

      <div class="privacy-request__field">
        <label class="privacy-request__field-label" for="privacy-request-email">Email</label>
        <input class="privacy-request__control" id="privacy-request-email" required type="email" name="email">
      </div>

      <div class="privacy-request__actions">
        <button class="privacy-request__submit" type="submit" disabled>Submit</button>
      </div>

      <p class="privacy-request__alt">Other ways to submit a new Privacy Request:</p>

      <div class="privacy-request__alt-email">
        <span class="privacy-request__alt-email-label">Email:</span>
        <a class="privacy-request__alt-email-link" href="mailto:privacy@smithey.com">privacy@smithey.com</a>
      </div>
    </form>
  </div>
</div>

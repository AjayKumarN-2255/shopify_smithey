{% comment %}
  Gift modal — interactive name/email/message with inline validation + live preview.
  Rendered only for giftcard products from snippets/product-details.liquid
{% endcomment %}
<div
  class="gift-modal"
  data-gift-modal
  data-gift-variant-id="{{ product.selected_or_first_available_variant.id }}"
  hidden
  aria-hidden="true"
>
  <div class="gift-modal__overlay" data-gift-modal-close></div>

  <div class="gift-modal__dialog" role="dialog" aria-modal="true" aria-label="Add a personal touch!">
    <button type="button" class="gift-modal__close" data-gift-modal-close aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M1 1L17 17M17 1L1 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>

    <h2 class="gift-modal__title">Add a personal touch!</h2>

    <div class="gift-modal__body">
      <div class="gift-modal__form-col">
        <p class="gift-modal__desc">We'll directly email the recipient a link to open your greeting card and redeem your gift.</p>

        <div class="gift-modal__to-row">
          <label class="gift-modal__label gift-modal__label--to" for="gift-recipient-name">To:</label>
          <div class="gift-modal__field">
            <input
              id="gift-recipient-name"
              class="gift-modal__input gift-modal__input--to"
              type="text"
              value=""
              placeholder="Recipient's Name"
              autocomplete="off"
              data-gift-name
            >
            <p class="gift-modal__error" data-gift-name-error hidden>Input is invalid!</p>
          </div>
        </div>
        <div class="gift-modal__to-row">
          <span class="gift-modal__label gift-modal__label--to gift-modal__label--spacer" aria-hidden="true"></span>
          <div class="gift-modal__field">
            <input
              id="gift-recipient-email"
              class="gift-modal__input gift-modal__input--to"
              type="email"
              value=""
              placeholder="Recipient's Email"
              autocomplete="off"
              data-gift-email
            >
            <p class="gift-modal__error" data-gift-email-error hidden>This is not a valid email</p>
          </div>
        </div>

        <label class="gift-modal__label gift-modal__label--stacked" for="gift-message">Personalized<br>Message:</label>
        <div class="gift-modal__message-row">
          <label class="gift-modal__label gift-modal__label--inline" for="gift-message-desktop">Personalized Message:</label>
          <div class="gift-modal__field gift-modal__field--message">
            <textarea
              id="gift-message-desktop"
              class="gift-modal__textarea"
              rows="2"
              maxlength="500"
              placeholder="Enjoy your Smithey!"
              data-gift-message
            ></textarea>
          </div>
        </div>
        <p class="gift-modal__count" data-gift-count>0/500</p>

        <div class="gift-modal__delivery">
          <span class="gift-modal__delivery-btn gift-modal__delivery-btn--active">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <rect x="1.5" y="3" width="17" height="15" rx="1" stroke="currentColor" stroke-width="1.4" />
              <path d="M1.5 7.5H18.5M6 1.5V4M14 1.5V4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              <path d="M7 11.5L9.2 13.7L13.5 9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Now
          </span>
          <span class="gift-modal__delivery-btn">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <rect x="1.5" y="3" width="17" height="15" rx="1" stroke="currentColor" stroke-width="1.4" />
              <path d="M1.5 7.5H18.5M6 1.5V4M14 1.5V4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              <g fill="currentColor">
                <rect x="5" y="10" width="2" height="2" rx="0.3" />
                <rect x="8" y="10" width="2" height="2" rx="0.3" />
                <rect x="11" y="10" width="2" height="2" rx="0.3" />
                <rect x="5" y="13" width="2" height="2" rx="0.3" />
                <rect x="8" y="13" width="2" height="2" rx="0.3" />
              </g>
            </svg>
            Choose Date
          </span>
        </div>
      </div>

      <div class="gift-modal__preview-col">
        <div class="gift-modal__preview-card">
          {% if product.featured_image %}
            {{
              product.featured_image
              | image_url: width: 600
              | image_tag: loading: 'lazy', class: 'gift-modal__preview-image', alt: product.title, width: 400, height: 300
            }}
          {% else %}
            <img
              class="gift-modal__preview-image"
              src="https://smithey.com/cdn/shop/files/usa_500x.png?v=1695064478"
              alt="{{ product.title | escape }}"
              loading="lazy"
              width="400"
              height="300"
            >
          {% endif %}
          <p class="gift-modal__preview-quote">
            <span class="gift-modal__quote-mark gift-modal__quote-mark--left" aria-hidden="true">&ldquo;</span>
            <span data-gift-quote-text>Enjoy your Smithey!</span>
            <span class="gift-modal__quote-mark gift-modal__quote-mark--right" aria-hidden="true">&rdquo;</span>
          </p>
        </div>
      </div>
    </div>

    <div class="gift-modal__footer">
      <p class="gift-modal__error gift-modal__submit-error" data-gift-submit-error hidden></p>
      <button type="button" class="gift-modal__add" data-gift-add>ADD TO CART</button>
    </div>
  </div>
</div>

<script>
  (function () {
    function initGiftModal() {
      var modal = document.querySelector('[data-gift-modal]');
      var openBtn = document.querySelector('[data-gift-modal-open]');
      if (!modal || !openBtn) return;
      if (modal.dataset.bound) return;
      modal.dataset.bound = 'true';

      var nameInput = modal.querySelector('[data-gift-name]');
      var emailInput = modal.querySelector('[data-gift-email]');
      var messageInput = modal.querySelector('[data-gift-message]');
      var quoteText = modal.querySelector('[data-gift-quote-text]');
      var count = modal.querySelector('[data-gift-count]');
      var nameError = modal.querySelector('[data-gift-name-error]');
      var emailError = modal.querySelector('[data-gift-email-error]');
      var addBtn = modal.querySelector('[data-gift-add]');
      var submitError = modal.querySelector('[data-gift-submit-error]');
      var defaultQuote = 'Enjoy your Smithey!';
      var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      var isAdding = false;

      function getVariantId() {
        var variantInput = document.querySelector('[data-gift-variant-input]');
        if (variantInput && variantInput.value) return variantInput.value;
        return modal.dataset.giftVariantId || '';
      }

      function openModal() {
        modal.hidden = false;
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        clearSubmitError();
      }
      function closeModal() {
        modal.hidden = true;
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      function showSubmitError(message) {
        if (!submitError) return;
        submitError.textContent = message;
        submitError.hidden = false;
      }

      function clearSubmitError() {
        if (!submitError) return;
        submitError.textContent = '';
        submitError.hidden = true;
      }

      function setAdding(adding) {
        isAdding = adding;
        if (!addBtn) return;
        addBtn.disabled = adding;
        addBtn.setAttribute('aria-busy', adding ? 'true' : 'false');
        addBtn.textContent = adding ? 'ADDING...' : 'ADD TO CART';
      }

      async function addGiftToCart(properties) {
        var variantId = getVariantId();
        if (!variantId) {
          throw new Error('Unable to add this product to the cart.');
        }
        if (
          window.SmitheyCart &&
          typeof window.SmitheyCart.addItems === 'function'
        ) {
          return window.SmitheyCart.addItems([
            { id: Number(variantId), quantity: 1, properties: properties }
          ]);
        }

        var response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            id: Number(variantId),
            quantity: 1,
            properties: properties
          })
        });

        if (!response.ok) {
          var data = {};
          try {
            data = await response.json();
          } catch (e) {
            data = {};
          }
          throw new Error(data.description || data.message || 'Something went wrong. Please try again.');
        }
      }
      function setInvalid(input, errorEl, isInvalid) {
        if (!input || !errorEl) return;
        input.classList.toggle('is-invalid', isInvalid);
        if (isInvalid) {
          errorEl.hidden = false;
          input.setAttribute('aria-invalid', 'true');
        } else {
          errorEl.hidden = true;
          input.removeAttribute('aria-invalid');
        }
      }

      function validateName() {
        var valid = nameInput && nameInput.value.trim().length > 0;
        setInvalid(nameInput, nameError, !valid);
        return valid;
      }

      function validateEmail() {
        var value = emailInput ? emailInput.value.trim() : '';
        var valid = emailPattern.test(value);
        setInvalid(emailInput, emailError, !valid);
        return valid;
      }

      if (messageInput) {
        messageInput.addEventListener('input', function () {
          var value = messageInput.value;
          if (value.length > 500) {
            value = value.slice(0, 500);
            messageInput.value = value;
          }
          if (count) count.textContent = value.length + '/500';
          if (quoteText) quoteText.textContent = value.trim().length > 0 ? value : defaultQuote;
        });
      }

      if (nameInput) {
        nameInput.addEventListener('input', function () {
          if (nameInput.value.trim().length > 0) setInvalid(nameInput, nameError, false);
        });
      }

      if (emailInput) {
        emailInput.addEventListener('input', function () {
          if (emailPattern.test(emailInput.value.trim())) setInvalid(emailInput, emailError, false);
        });
      }

      if (addBtn) {
        addBtn.addEventListener('click', async function () {
          if (isAdding) return;
          clearSubmitError();

          var nameValid = validateName();
          var emailValid = validateEmail();
          if (!nameValid && nameInput) {
            nameInput.focus();
            return;
          }
          if (!emailValid && emailInput) {
            emailInput.focus();
            return;
          }

          var properties = {
            Name: nameInput.value.trim(),
            Email: emailInput.value.trim()
          };
          var message = messageInput ? messageInput.value.trim() : '';
          if (message.length > 0) properties.Message = message;

          setAdding(true);
          try {
            await addGiftToCart(properties);
            closeModal();
            if (
              !window.SmitheyCart ||
              typeof window.SmitheyCart.addItems !== 'function'
            ) {
              window.location.href = '/cart';
            }
          } catch (error) {
            showSubmitError(error.message || 'Something went wrong. Please try again.');
          } finally {
            setAdding(false);
          }
        });
      }

      openBtn.addEventListener('click', openModal);
      modal.querySelectorAll('[data-gift-modal-close]').forEach(function (el) {
        el.addEventListener('click', closeModal);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modal.hidden) closeModal();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGiftModal);
    } else {
      initGiftModal();
    }
  })();
</script>

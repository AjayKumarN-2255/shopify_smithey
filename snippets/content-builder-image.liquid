{% if block.settings.image != blank %}
  <div
    id="content-builder-image-{{ block.id }}"
    class="content-builder__image"
    {{ block.shopify_attributes }}
  >
    <img
      src="{{ block.settings.image | image_url: width: 2000 }}"
      alt="{{ block.settings.image.alt | escape }}"
      width="{{ block.settings.image.width }}"
      height="{{ block.settings.image.height }}"
    >
  </div>
{% endif %}

{% assign selector = '#content-builder-image-' | append: block.id %}

<style>
  #content-builder-image-{{ block.id }} {
    width: 100%;
    height: {{ block.settings.image_mobile_height }}rem;
    margin: 1rem 0;
  }

  #content-builder-image-{{ block.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 920px) {
    #content-builder-image-{{ block.id }} {
      height: {{ block.settings.image_desktop_height }}rem;
      margin-top: 0;
    }
  }

  @media (min-width: 1700px) {
    #content-builder-image-{{ block.id }} {
      height: {{ block.settings.image_large_desktop_height }}rem;
      margin-top: 0;
      margin-bottom: 4rem;
    }
  }

  {{ block.settings.custom_css | replace: '&', selector }}
</style>
